@namespace NovinApp.Client.Component
@using MudBlazor

<div class="page-banner @BannerClass mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div class="d-flex align-center gap-3">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <MudAvatar Color="Color.Surface" Size="Size.Large" Elevation="2" Style="color: var(--mud-palette-primary); min-width: 48px; min-height: 48px;">
                    <MudIcon Icon="@Icon" Size="Size.Medium" />
                </MudAvatar>
            }
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold text-white" Style="font-size: 1.25rem;">
                    @Title
                </MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="Typo.body2" Class="mt-1 text-white" Style="opacity: 0.9; font-size: 0.85rem;">
                        @Subtitle
                    </MudText>
                }
            </div>
        </div>

        @if (ChildContent != null)
        {
            <div class="d-flex align-center flex-wrap gap-2">
                @ChildContent
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string BannerClass { get; set; } = "banner-primary";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
