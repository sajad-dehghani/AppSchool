@using NovinApp.Shared
@inject IJSRuntime JS

<div class="comprehensive-report-container" id="printableComprehensiveReport">
    @* نوار ابزار بالا (فقط در نمایش وب، پنهان در پرینت) *@
    <div class="report-toolbar no-print">
        <div class="d-flex justify-space-between align-center flex-wrap gap-3">
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Size="Size.Large" OnClick="PrintReport" Class="px-6 py-2 rounded-lg font-weight-bold">
                    چاپ و دریافت کارنامه رسمی (PDF)
                </MudButton>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Verified">
                    نسخه رسمی استاندارد هدایت تحصیلی
                </MudChip>
            </div>
            @if (OnBack.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="OnBack" Class="rounded-lg">
                    بازگشت
                </MudButton>
            }
        </div>
    </div>

    @* ==========================================
       صفحه ۱: جلد رسمی کارنامه (Cover Page)
       ========================================== *@
    <div class="report-page page-cover">
        <div class="cover-art-container">
            <div class="cover-art-shape shape-blue"></div>
            <div class="cover-art-shape shape-yellow"></div>
            <div class="cover-art-shape shape-green"></div>
            <div class="cover-art-shape shape-cyan"></div>
        </div>

        <div class="cover-content">
            <div class="cover-badge">سامانه هوشمند هدایت تحصیلی و شغلی</div>
            <h1 class="cover-title">کارنامه جامع هدایت تحصیلی و شغلی</h1>
            <p class="cover-subtitle">سنجش رغبت، توانمندی‌های ذهنی و انطباق با ۱۸ حوزه کاری و ۷ شاخه تحصیلی</p>

            <div class="cover-info-card">
                <div class="info-row">
                    <span class="info-label">نام و نام خانوادگی:</span>
                    <span class="info-val">@Report.StudentName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">کد ملی دانش‌آموز:</span>
                    <span class="info-val">@Report.StudentNationalCode</span>
                </div>
                <div class="info-row">
                    <span class="info-label">مشاور هدایت تحصیلی:</span>
                    <span class="info-val">@Report.CounselorName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">مرکز آموزشی / موسسه:</span>
                    <span class="info-val">@Report.InstitutionName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">تاریخ صدور کارنامه:</span>
                    <span class="info-val">@Report.TestDatePersian</span>
                </div>
            </div>
        </div>

        <div class="page-footer-single">
            <span>سامانه هدایت تحصیلی نوین</span>
            <span>صفحه ۱</span>
        </div>
    </div>

    @* ==========================================
       صفحه ۲: مقدمه و فهرست کارنامه
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(2)

        <div class="page-body">
            <div class="page-two-cols">
                @* ستون راست: متن مقدمه علمی *@
                <div class="intro-column">
                    <div class="section-badge-header">
                        <span class="badge-icon">📖</span>
                        <h2>مقدمه</h2>
                    </div>
                    <div class="intro-text-box">
                        <p>
                            کارنامه پیش رو که با هدف هدایت تحصیلی و شغلی در اختیار شما قرار گرفته است، حاصل بررسی دقیق و تخصصی مقیاس‌های استاندارد روانشناختی، رغبت‌سنجی و استعدادهای چندگانه می‌باشد.
                        </p>
                        <p>
                            با عنایت به توضیحات فوق، نتایج گزارش‌شده در این کارنامه با توجه به ویژگی‌های شخصیتی، توانمندی‌ها و انتظارات شما از رشته تحصیلی ارائه شده است. علایق فردی معمولاً متأثر از ساختار روانشناختی و توانمندی‌های فردی هستند؛ بنابراین با تقریب بالایی این دو در یک راستا عمل می‌کنند.
                        </p>
                        <p>
                            باید در نظر داشت که این کارنامه نقش <strong>هدایت‌کننده، افق‌گشا و پیشنهاددهنده</strong> را دارد و بخشی از موفقیت تحصیلی و شغلی را با تحلیل علمی پیش‌بینی می‌کند؛ لذا شایسته است تصمیم‌گیری نهایی با همراهی و مشورت خانواده و مشاور تحصیلی شما انجام گیرد تا بهترین نتیجه حاصل شود.
                        </p>
                    </div>
                </div>

                @* ستون چپ: فهرست مطالب کارنامه *@
                <div class="toc-column">
                    <div class="toc-box">
                        <div class="toc-title">آنچه در این کارنامه مشاهده می‌کنیم:</div>
                        <ul class="toc-list">
                            <li><span class="check-icon">✓</span> مقدمه و چارچوب علمی آزمون</li>
                            <li><span class="check-icon">✓</span> کارنامه ارزیابی شخصیت و سبک تفکر</li>
                            <li><span class="check-icon">✓</span> وضعیت شما در یک نگاه (۷ شاخه تحصیلی)</li>
                            <li>
                                <span class="check-icon">✓</span> انطباق با ۱۸ حوزه کاری و شغلی:
                                <ul class="toc-sublist">
                                    @foreach (var domain in Report.Domains.Take(9))
                                    {
                                        <li>• @domain.Name</li>
                                    }
                                </ul>
                            </li>
                            <li><span class="check-icon">✓</span> رشته‌های دارای بالاترین اولویت در شاخه‌ها (امتیاز ستاره‌ای)</li>
                            <li><span class="check-icon">✓</span> وضعیت رشته‌های دارای فاصله با روحیات شما</li>
                            <li><span class="check-icon">✓</span> نظریه نهایی و تحلیل هوش مصنوعی اختصاصی</li>
                            <li><span class="check-icon">✓</span> پیوست معرفی دسته‌بندی‌های تحصیلی</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @RenderPageFooter(2)
    </div>

    @* ==========================================
       صفحه ۳: کارنامه ارزیابی شخصیت
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(3)

        <div class="page-body">
            <div class="section-title-banner">
                <span class="banner-icon">👤</span>
                <h2>کارنامه ارزیابی شخصیت و سبک یادگیری</h2>
            </div>

            <div class="personality-narrative-card">
                <p>@Report.PersonalitySummary</p>
            </div>

            @* چکیده ویژگی‌های شاخص *@
            <div class="traits-highlights-grid mt-4">
                <div class="trait-highlight-box">
                    <div class="trait-icon">🎯</div>
                    <div class="trait-title">رویکرد هدف‌گذاری</div>
                    <div class="trait-desc">پیشبرد برنامه‌ریزی تحصیلی بر مبنای آرامش، تمرکز پایدار و پرهیز از شتاب‌زدگی فرساینده.</div>
                </div>
                <div class="trait-highlight-box">
                    <div class="trait-icon">🤝</div>
                    <div class="trait-title">سبک تعاملی</div>
                    <div class="trait-desc">سازگاری با کار تیمی همراه با حفظ استقلال فکری در تحلیل مفاهیم و حل مسئله.</div>
                </div>
                <div class="trait-highlight-box">
                    <div class="trait-icon">💡</div>
                    <div class="trait-title">مهارت یادگیری</div>
                    <div class="trait-desc">درک مفهومی الگوها و علاقه به کاربردی‌سازی آموخته‌ها در دنیای واقعی.</div>
                </div>
            </div>
        </div>

        @RenderPageFooter(3)
    </div>

    @* ==========================================
       صفحه ۴: وضعیت شما در یک نگاه (۷ شاخه تحصیلی)
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(4)

        <div class="page-body">
            <div class="section-title-banner">
                <span class="banner-icon">👁️</span>
                <h2>وضعیت شما در یک نگاه (شاخه های تحصیلی دوره دوم متوسطه)</h2>
            </div>
            <p class="section-guide-text">
                در این جداول، با توجه به استعدادها و رغبت‌های شما در هر شاخه تحصیلی و میزان انطباق آن با جامعه تحصیلی، وضعیت شما به تفکیک رشته‌های سازگار و غیرسازگار گزارش شده است:
            </p>

            <div class="branch-summary-tables">
                @foreach (var branch in Report.BranchStatuses)
                {
                    <div class="branch-status-row">
                        <div class="branch-header-col" style="background-color: @branch.HeaderColor;">
                            <span class="branch-name">@branch.BranchName</span>
                        </div>
                        <div class="branch-suitability-col" style="background-color: @branch.SuitabilityColor;">
                            <span class="suitability-label">میزان تناسب</span>
                            <span class="suitability-val">@branch.Suitability</span>
                        </div>
                        <div class="branch-content-col good-majors">
                            <span class="col-title">رشته‌های دارای اولویت و مناسب:</span>
                            <span class="majors-text">@(string.Join(" • ", branch.SuitableMajors))</span>
                        </div>
                        <div class="branch-content-col bad-majors">
                            <span class="col-title">رشته‌های دارای عدم انطباق:</span>
                            <span class="majors-text">@(string.Join(" • ", branch.UnsuitableMajors))</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @RenderPageFooter(4)
    </div>

    @* ==========================================
       صفحه ۵: نمودار مقایسه‌ای ۱۸ حوزه کاری
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(5)

        <div class="page-body">
            <div class="section-title-banner">
                <span class="banner-icon">📊</span>
                <h2>بررسی تطابق تحصیلی و شغلی (نمودار ۱۸ حوزه کاری)</h2>
            </div>
            <p class="section-guide-text">
                در این بخش با بررسی رشته-شغل‌ها در ۱۸ حوزه کاری، میزان تطابق شخصیت، توانمندی و رغبت‌های شما گزارش شده است. هر چه درصد این انطباق بیشتر باشد، احتمال رضایت‌مندی و موفقیت شغلی شما در آینده بالاتر خواهد بود:
            </p>

            <div class="domains-barchart-container">
                @foreach (var domain in Report.Domains)
                {
                    <div class="barchart-item">
                        <div class="barchart-meta">
                            <span class="domain-id">@domain.Id</span>
                            <span class="domain-title">@domain.Name</span>
                        </div>
                        <div class="barchart-bar-track">
                            <div class="barchart-bar-fill" style="width: @domain.MatchPercentage%; background-color: @domain.ColorHex;"></div>
                        </div>
                        <span class="barchart-percent" style="color: @domain.ColorHex;">@domain.MatchPercentage%</span>
                    </div>
                }
            </div>
        </div>

        @RenderPageFooter(5)
    </div>

    @* ==========================================
       صفحات ۶ تا ۱۰: ارزیابی تفکیکی ۱۸ حوزه کاری با گیج عقربه‌ای
       ========================================== *@
    @for (int chunkIndex = 0; chunkIndex < 5; chunkIndex++)
    {
        var domainChunk = Report.Domains.Skip(chunkIndex * 4).Take(4).ToList();
        if (domainChunk.Any())
        {
            int pageNum = 6 + chunkIndex;
            <div class="report-page">
                @RenderPageHeader(pageNum)

                <div class="page-body">
                    <div class="section-title-banner compact">
                        <span class="banner-icon">🧭</span>
                        <h2>ارزیابی تخصصی حوزه‌های شغلی و تحصیلی (صفحه @(chunkIndex + 1) از ۵)</h2>
                    </div>

                    <div class="domain-cards-grid">
                        @foreach (var d in domainChunk)
                        {
                            <div class="domain-card">
                                <div class="domain-card-header">
                                    <span class="domain-badge-number">#@d.Id</span>
                                    <h3 class="domain-name">@d.Name</h3>
                                </div>

                                <div class="domain-card-body">
                                    <div class="domain-gauge-side">
                                        @RenderSpeedometerGauge(d.MatchPercentage)
                                    </div>
                                    <div class="domain-info-side">
                                        <p class="domain-description">@d.Description</p>
                                        <div class="domain-jobs-box">
                                            <strong>مشاغل و حرفه‌های پیشنهادی:</strong>
                                            <p class="jobs-list">@(string.Join(" ، ", d.SuggestedJobs))</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @RenderPageFooter(pageNum)
            </div>
        }
    }

    @* ==========================================
       صفحه ۱۱: جدول رشته‌های پیشنهادی برتر (ستاره‌دار ★)
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(11)

        <div class="page-body">
            <div class="section-title-banner">
                <span class="banner-icon">⭐</span>
                <h2>رشته‌های پیشنهادی دارای بالاترین تناسب با شخصیت و استعداد شما</h2>
            </div>
            <p class="section-guide-text">
                رشته‌های زیر بر مبنای بالاترین ضریب همبستگی با استعدادها و تیپ روانشناختی شما اولویت‌بندی شده‌اند:
            </p>

            <div class="stars-table-container">
                <table class="custom-report-table">
                    <thead>
                        <tr>
                            <th style="width: 8%;">ردیف</th>
                            <th style="width: 42%;">نام رشته تحصیلی / دانشگاهی</th>
                            <th style="width: 25%;">شاخه مربوطه</th>
                            <th style="width: 25%;">میزان تناسب با شخصیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Report.RecommendedMajors.Count; i++)
                        {
                            var item = Report.RecommendedMajors[i];
                            <tr>
                                <td class="text-center font-weight-bold">@(i + 1)</td>
                                <td class="major-name-cell">@item.MajorName</td>
                                <td class="branch-cell">@item.BranchName</td>
                                <td class="stars-cell">
                                    @for (int s = 0; s < item.Stars; s++)
                                    {
                                        <span class="star-gold">★</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @RenderPageFooter(11)
    </div>

    @* ==========================================
       صفحه ۱۲: رشته‌های دارای فاصله با ویژگی‌های فردی (↓↓↓)
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(12)

        <div class="page-body">
            <div class="section-title-banner">
                <span class="banner-icon">📉</span>
                <h2>وضعیت شما در سایر رشته‌ها (رشته‌های دارای فاصله)</h2>
            </div>
            <p class="section-guide-text">
                در جدول زیر لیست رشته‌هایی که کمترین همخوانی را با ویژگی‌های روانشناختی شما داشته‌اند ذکر شده است. انتخاب این رشته‌ها به دلیل احتمال بالای فرسودگی و عدم رضایت توصیه نمی‌گردد:
            </p>

            <div class="distance-table-container">
                <table class="custom-report-table distant-table">
                    <thead>
                        <tr>
                            <th style="width: 8%;">ردیف</th>
                            <th style="width: 42%;">نام رشته</th>
                            <th style="width: 25%;">شاخه مربوطه</th>
                            <th style="width: 25%;">میزان فاصله با روحیات شما</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Report.DistantMajors.Count; i++)
                        {
                            var item = Report.DistantMajors[i];
                            <tr>
                                <td class="text-center font-weight-bold">@(i + 1)</td>
                                <td class="major-name-cell">@item.MajorName</td>
                                <td class="branch-cell">@item.BranchName</td>
                                <td class="arrows-cell">
                                    @for (int a = 0; a < item.DistanceArrows; a++)
                                    {
                                        <span class="arrow-red">↓</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @RenderPageFooter(12)
    </div>

    @* ==========================================
       صفحه ۱۳: نظریه نهایی و تحلیل هوش مصنوعی و جمع‌بندی
       ========================================== *@
    <div class="report-page">
        @RenderPageHeader(13)

        <div class="page-body">
            <div class="section-title-banner ai-banner">
                <span class="banner-icon">🤖</span>
                <h2>نظریه و ارزیابی نهایی هوش مصنوعی انتخاب رشته (سامانه نوین)</h2>
            </div>

            <div class="ai-advice-container">
                <div class="ai-box-content">
                    <p style="white-space: pre-line; line-height: 2.2;">
                        @(Report.AiFinalGuidance ?? "تحلیل هوش مصنوعی برای این آزمون ثبت شده و آماده بهره‌برداری مشاوره‌ای می‌باشد.")
                    </p>
                </div>
            </div>

            <div class="signature-box mt-6">
                <div class="signature-col">
                    <span>امضاء و تایید دانش‌آموز:</span>
                    <div class="sign-line"></div>
                </div>
                <div class="signature-col">
                    <span>امضاء ولی دانش‌آموز:</span>
                    <div class="sign-line"></div>
                </div>
                <div class="signature-col">
                    <span>مهر و امضاء مشاور تحصیلی:</span>
                    <div class="sign-line"></div>
                </div>
            </div>
        </div>

        @RenderPageFooter(13)
    </div>
</div>

@* ==========================================
   متدهای کمکی جهت رندر هدر، فوتر و گیج عقربه‌ای
   ========================================== *@
@code {
    [Parameter] public ComprehensiveCareerReport Report { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private RenderFragment RenderPageHeader(int pageNum) => __builder =>
    {
        <div class="page-header">
            <div class="header-logo-side">
                <span class="brand-title">سامانه هدایت تحصیلی نوین</span>
            </div>
            <div class="header-student-meta">
                <span><strong>نام و نام خانوادگی:</strong> @Report.StudentName</span>
                <span><strong>مشاور:</strong> @Report.CounselorName</span>
                <span><strong>موسسه:</strong> @Report.InstitutionName</span>
            </div>
        </div>
    };

    private RenderFragment RenderPageFooter(int pageNum) => __builder =>
    {
        <div class="page-footer">
            <span class="footer-site">novin-app.ir</span>
            <span class="footer-title">سامانه هدایت تحصیلی و شغلی دانش‌آموزی</span>
            <span class="footer-page-num">@pageNum | صفحه</span>
        </div>
    };

    private RenderFragment RenderSpeedometerGauge(int percentage) => __builder =>
    {
        // محاسبه زاویه عقربه: از 180 درجه تا 360 درجه (نیم دایره بالا)
        double clamped = Math.Clamp(percentage, 0, 100);
        double angleDeg = 180 + (clamped / 100.0) * 180.0;
        double rad = angleDeg * Math.PI / 180.0;
        double cx = 100, cy = 95, r = 60;
        double xTip = cx + (r - 10) * Math.Cos(rad);
        double yTip = cy + (r - 10) * Math.Sin(rad);

        <div class="speedometer-box">
            <svg viewBox="0 0 200 125" class="speedometer-svg">
                <defs>
                    <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#e53935" />
                        <stop offset="40%" stop-color="#fb8c00" />
                        <stop offset="70%" stop-color="#fdd835" />
                        <stop offset="100%" stop-color="#43a047" />
                    </linearGradient>
                </defs>
                <!-- قوس پس‌زمینه رنگی -->
                <path d="M 25,95 A 75,75 0 0,1 175,95" fill="none" stroke="url(#gaugeGradient)" stroke-width="16" stroke-linecap="round" />
                
                <!-- خط عقربه -->
                <line x1="@cx" y1="@cy" x2="@xTip.ToString("F1")" y2="@yTip.ToString("F1")" stroke="#212121" stroke-width="4" stroke-linecap="round" />
                <circle cx="@cx" cy="@cy" r="7" fill="#212121" />
                <circle cx="@cx" cy="@cy" r="3" fill="#ffffff" />
            </svg>
            <div class="gauge-score-text">
                <span class="score-number">@percentage%</span>
