@page "/Schools"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NovinApp.Client.Service
@using NovinApp.Client.Component
@using NovinApp.Shared.Constants
@using NovinApp.Shared.DTOs.Common
@using NovinApp.Shared.DTOs.Schools
@inject HttpClient _http
@inject ISnackbar snackBar
@inject IDialogService dialogService
@inject UserProfileStateService UserProfileState
@attribute [Authorize(Roles = UserRoles.SystemAdmin)]

<div class="page-banner banner-primary mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" Class="ml-2 align-middle" />
                مدیریت مدارس و واحدهای آموزشی
            </MudText>
            <MudText Typo="Typo.body2" Class="text-white mt-1" Style="opacity: 0.9;">
                تعریف مدارس، کد منطقه، مشخصات تماس و انتساب مدیران مدارس
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Surface" StartIcon="@Icons.Material.Filled.Add"
                   Class="text-primary font-weight-bold" OnClick="OpenCreateDialog">
            ثبت مدرسه جدید
        </MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="modern-card pa-4">
    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
        <MudTextField @bind-Value="searchString" Placeholder="جستجوی نام مدرسه، کد یا منطقه..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="max-w-300" />
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
            تعداد کل: @schools.Count مدرسه
        </MudChip>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center align-center my-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.subtitle2" Class="ms-3">در حال بارگذاری اطلاعات مدارس...</MudText>
        </div>
    }
    else if (!FilteredSchools.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="rounded-lg my-4">
            هیچ مدرسه‌ای ثبت نگردیده است یا با فیلتر جستجو همخوانی ندارد.
        </MudAlert>
    }
    else
    {
        <MudTable Items="@FilteredSchools" Hover="true" Striped="true" Elevation="0" Dense="true">
            <HeaderContent>
                <MudTh>نام مدرسه</MudTh>
                <MudTh>کد مدرسه</MudTh>
                <MudTh>منطقه</MudTh>
                <MudTh>تلفن</MudTh>
                <MudTh>تعداد دانش‌آموزان</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh Class="text-center">عملیات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="نام مدرسه">
                    <span class="font-weight-bold text-primary">@context.Name</span>
                </MudTd>
                <MudTd DataLabel="کد مدرسه">@(context.SchoolCode?.ToString() ?? "---")</MudTd>
                <MudTd DataLabel="منطقه">@(context.RegionName ?? "---")</MudTd>
                <MudTd DataLabel="تلفن">@(context.PhoneNumber ?? "---")</MudTd>
                <MudTd DataLabel="تعداد دانش‌آموزان">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                        @context.StudentsCount نفر
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="وضعیت">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">فعال</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">غیرفعال</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="عملیات" Class="text-center">
                    <MudTooltip Text="ویرایش مدرسه">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(context))" />
                    </MudTooltip>
                    <MudTooltip Text="حذف مدرسه">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteSchool(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@* دیالوگ ثبت / ویرایش مدرسه *@
<MudDialog @bind-Visible="isDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            @(isEditMode ? "ویرایش مشخصات مدرسه" : "ثبت مدرسه جدید")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@currentModel" OnValidSubmit="SaveSchool">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2" Class="pt-2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentModel.Name" Label="نام مدرسه" Variant="Variant.Outlined"
                                  Required="true" For="@(() => currentModel.Name)" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="currentModel.SchoolCode" Label="کد مدرسه" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentModel.RegionName" Label="منطقه آموزشی" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="currentModel.PhoneNumber" Label="تلفن تماس" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="currentModel.Address" Label="آدرس کامل" Variant="Variant.Outlined"
                                  Lines="2" Margin="Margin.Dense" />
                </MudItem>
                @if (isEditMode)
                {
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="isSchoolActive" Label="وضعیت فعالیت مدرسه" Color="Color.Success" />
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isDialogOpen = false)" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSchool" Disabled="isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>در حال ذخیره...</span>
            }
            else
            {
                <span>ذخیره اطلاعات</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<SchoolDto> schools = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDialogOpen = false;
    private bool isEditMode = false;
    private string searchString = "";
    private int editingId = 0;
    private bool isSchoolActive = true;

    private CreateSchoolDto currentModel = new();

    private DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true
    };

    private IEnumerable<SchoolDto> FilteredSchools =>
        string.IsNullOrWhiteSpace(searchString)
            ? schools
            : schools.Where(s => s.Name.Contains(searchString) ||
                                (s.RegionName?.Contains(searchString) ?? false) ||
                                (s.SchoolCode?.ToString().Contains(searchString) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        isLoading = true;
        try
        {
            var res = await _http.GetFromJsonAsync<ApiResponse<List<SchoolDto>>>("api/schools");
            if (res != null && res.Success && res.Data != null)
            {
                schools = res.Data;
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا در بارگذاری مدارس: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        isEditMode = false;
        editingId = 0;
        isSchoolActive = true;
        currentModel = new CreateSchoolDto();
        isDialogOpen = true;
    }

    private void OpenEditDialog(SchoolDto school)
    {
        isEditMode = true;
        editingId = school.Id;
        isSchoolActive = school.IsActive;
        currentModel = new CreateSchoolDto
        {
            Name = school.Name,
            SchoolCode = school.SchoolCode,
            RegionName = school.RegionName,
            Address = school.Address,
            PhoneNumber = school.PhoneNumber,
            ManagerUserId = school.ManagerUserId
        };
        isDialogOpen = true;
    }

    private async Task SaveSchool()
    {
        if (string.IsNullOrWhiteSpace(currentModel.Name))
        {
            snackBar.Add("نام مدرسه الزامی است.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            if (isEditMode)
            {
                var updateDto = new UpdateSchoolDto
                {
                    Id = editingId,
                    Name = currentModel.Name,
                    SchoolCode = currentModel.SchoolCode,
                    RegionName = currentModel.RegionName,
                    Address = currentModel.Address,
                    PhoneNumber = currentModel.PhoneNumber,
                    ManagerUserId = currentModel.ManagerUserId,
                    IsActive = isSchoolActive
                };

                var res = await _http.PutAsJsonAsync($"api/schools/{editingId}", updateDto);
                var apiRes = await res.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                if (apiRes?.Success == true)
                {
                    snackBar.Add("مدرسه با موفقیت ویرایش شد.", Severity.Success);
                    isDialogOpen = false;
                    await LoadSchools();
                }
                else
                {
                    snackBar.Add(apiRes?.Message ?? "خطا در ویرایش مدرسه", Severity.Error);
                }
            }
            else
            {
                var res = await _http.PostAsJsonAsync("api/schools", currentModel);
                var apiRes = await res.Content.ReadFromJsonAsync<ApiResponse<SchoolDto>>();
                if (apiRes?.Success == true)
                {
                    snackBar.Add("مدرسه جدید با موفقیت ثبت شد.", Severity.Success);
                    isDialogOpen = false;
                    await LoadSchools();
                }
                else
                {
                    snackBar.Add(apiRes?.Message ?? "خطا در ثبت مدرسه", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطای سیستمی: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSchool(SchoolDto school)
    {
        var parameters = new DialogParameters();
        parameters.Add("mytext", $"آیا از حذف مدرسه «{school.Name}» اطمینان دارید؟");
        var dialog = await dialogService.ShowAsync<Alert_qoustion>("", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                var res = await _http.DeleteAsync($"api/schools/{school.Id}");
                var apiRes = await res.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                if (apiRes?.Success == true)
                {
                    snackBar.Add("مدرسه با موفقیت حذف شد.", Severity.Success);
                    await LoadSchools();
                }
                else
                {
                    snackBar.Add(apiRes?.Message ?? "خطا در حذف مدرسه", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                snackBar.Add($"خطا در حذف مدرسه: {ex.Message}", Severity.Error);
            }
        }
    }
}
