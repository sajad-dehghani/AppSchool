@page "/QuestionsList"
@using NovinApp.Client.Component
@using NovinApp.Client.Services
@using NovinApp.Shared
@using Microsoft.AspNetCore.Authorization
@using NovinApp.Client.Service
@inject IJSRuntime JsRuntime
@inject MudBlazor.ISnackbar snackBar
@inject NavigationManager nav
@inject IDialogService Dialog
@inject HttpClient _httpClient
@inject UserProfileStateService UserProfileState
@inject NavigationManager Nav
@attribute [Authorize]
<LoadingScreen>


    <MudText Class="mt-2" Typo="Typo.h4">📚 بانک سوالات</MudText>
    <MudDivider DividerType="DividerType.Inset" />
    <MudPaper>

        <MudGrid Class="mt-1 pa-4">
            <MudItem xs="12">
                <MudDataGrid Items="@data_list" T="Question" SelectedItem="@selectedItem" SelectedItems="@selectedItems" Filterable="true"
                             QuickFilter="@_quickFilter" RowClick="@RowClicked" Hover="true" Dense="@true" Striped="@true" Bordered="@true" RowStyleFunc="@_rowStyleFunc"
                             Class="cursor-pointer" Hideable="true" FixedHeader="true" Loading="isload">

                    <ToolBarContent>
                        <MudToolBar Class="d-flex align-center flex-wrap gap-1">
                            <MudTooltip Text="سوال جدید" Color="Color.Primary" Placement="Placement.Bottom" Arrow="true">
                                <MudIconButton OnClick="@(() => Add())"
                                               Color="Color.Primary"
                                               Icon="@Icons.Material.Outlined.AddCircleOutline"
                                               Size="Size.Small"
                                               Class="ml-1" />
                            </MudTooltip>
                            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                            <MudTooltip Text="تازه‌سازی اطلاعات" Color="Color.Success" Placement="Placement.Bottom" Arrow="true">
                                <MudIconButton OnClick="@(() => Btn_Refresh())"
                                               Icon="@Icons.Material.Outlined.Refresh"
                                               Color="Color.Success" />
                            </MudTooltip>

                        </MudToolBar>
                        <MudSpacer />

                        <MudTextField @bind-Value="_searchString"
                                      Placeholder="جستجوی ..."
                                      Adornment="Adornment.Start"
                                      Immediate="true"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Class="mt-0 search-box"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Clearable="true" />
                    </ToolBarContent>

                    <NoRecordsContent>
                        <MudText Align="Align.Center" Typo="Typo.body1" Class="pa-4">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2" />
                            <br />
                            اطلاعاتی یافت نشد
                            <br />
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Refresh"
                                       OnClick="@(() => Btn_Refresh())"
                                       Class="mt-2">
                                تازه‌سازی اطلاعات
                            </MudButton>
                        </MudText>
                    </NoRecordsContent>
                    <Columns>
                        <TemplateColumn Title="ردیف"
                                        Sortable="false"
                                        Filterable="false">
                            <CellTemplate>
                                @{
                                    var list = data_list.ToList();
                                    var idx = list.IndexOf(context.Item) + 1;
                                }
                                <MudText Typo="Typo.body2">@idx</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="نوع تست" Sortable="true" Filterable="true" >
                            <HeaderTemplate>
                                @((MarkupString)$"عنوان سوال {string.Join("", Enumerable.Repeat("&nbsp;", 100))}")
                            </HeaderTemplate>
                            <CellTemplate>
                                @((MarkupString)@context.Item.QuestionText)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="نوع تست" Sortable="true" Filterable="true">
                            <CellTemplate>
                                <MudChip T="string"
                                         Text="@context.Item.Groups"
                                         Variant="Variant.Outlined"
                                         Color="Color.Primary"
                                         Size="Size.Medium" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="عملیات" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="() => Edit(context.Item.Id)" Size="Size.Small" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Item.Id)" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        @if (data_list != null && data_list.Any())
                        {
                            <MudDataGridPager T="Question"
                                              PageSizeOptions="new int[]{15, 100}"
                                              RowsPerPageString="تعداد سطر در هر صفحه"
                                              InfoFormat="نمایش {first_item} تا {last_item} از مجموع {all_items}" />
                        }
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>


        <style>
            .cursor-pointer {
                cursor: pointer;
            }

            .ltr {
                direction: ltr;
            }

            .fw-bold {
                font-weight: bold;
            }

            .search-box {
                min-width: 250px;
            }
        </style>


    </MudPaper>


</LoadingScreen>
@code {
    private Question selectedItem = new Question();
    private HashSet<Question> selectedItems = new HashSet<Question>();

    private IEnumerable<Question> data_list = new List<Question>();
    private string _searchString = "";
    private int selectedRowNumber = -1;
    private int lastRowNumber = -1;

    public string SelectedOption { get; set; }
    Question data = new Question();
    bool isload = false;

    protected override async Task OnInitializedAsync()
    {
        await Btn_Refresh();
    }

    async Task Btn_Refresh()
    {
        try
        {
            isload = true;
            data_list = await _httpClient.GetFromJsonAsync<List<Question>>("api/Question/all") ?? new List<Question>();
            isload = false;

        }
        catch
        {
            isload = false;

            snackBar.Add("خطا در دریافت اطلاعات", Severity.Error);
        }
        await InvokeAsync(() => StateHasChanged());
    }


    async Task Add()
    {
        // Cls_global.select_row_titr = "Question";

        nav.NavigateTo("/NewQuestion");
    }

    async Task Edit(int id)
    {
        if (data_list.Count() >= 1)
        {

            Cls_global.select_row_id = id;
            Cls_global.IsEdit = true;
            // Cls_global.select_row_titr = "Question";

            nav.NavigateTo($"/NewQuestion");
        }
    }


    private Func<Question, int, string> _rowStyleFunc => (x, i) =>
    {
        if (selectedRowNumber == lastRowNumber)
        {
            lastRowNumber = selectedRowNumber;
            return "";
        }

        if (x.Id == selectedRowNumber)
            return "background-color: rgba(var(--mud-palette-primary-rgb), 0.12); border-left: 3px solid var(--mud-palette-primary);";

        return "";
    };

    void RowClicked(DataGridRowClickEventArgs<Question> args)
    {
        if (selectedRowNumber == args.Item.Id)
        {
            selectedRowNumber = -1;
        }
        else
        {
            selectedRowNumber = args.Item.Id;

        }
        //  Idrow = args.Item.rowId;
    }
    private Func<Question, bool> _quickFilter => x =>
{
    if (string.IsNullOrWhiteSpace(_searchString))
        return true;
    if (x.QuestionText.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        return true;


    return false;
};

    async Task Delete(int Id)
    {

        if (data_list.Count() >= 1)
        {

                if (await OpenDialog("آیا از حذف سطر انتخابی اطمینان دارید ؟").ConfigureAwait(false))
                {
                    var respon = await _httpClient.DeleteAsync($"api/Question/{Id}");

                    if (respon.IsSuccessStatusCode)
                    {
                        snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
                        snackBar.Add("اطلاعات مورد نظر با موفقیت حذف شد", Severity.Info);
                    }
                    else
                    {
                        snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
                        snackBar.Add("حذف اطلاعات با خطا مواجه شد", Severity.Error);
                    }
                    await Btn_Refresh();
                }
            
        }
    }

    public async Task<bool> OpenDialog(string txt)
    {
        var parameters = new DialogParameters();
        parameters.Add("mytext", txt);
        var dialog = await Dialog.ShowAsync<Alert_qoustion>("", parameters);
        var result = await dialog.Result;
        return !result.Canceled;
    }
}