                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="ml-2"
                           ButtonType="ButtonType.Submit"
                           Size="Size.Large">
                    @(Cls_global.IsEdit ? "بروزرسانی" : "ثبت")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="GoToBack"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Size="Size.Large">
                    انصراف
                </MudButton>
            </MudCardActions>
        </MudItem>
    </MudGrid>
</MudItem>
