    async Task LoadData()
    {
        try
        {
            data = await _httpClient.GetFromJsonAsync<Question>($"api/Question/{Cls_global.select_row_id}");

            string[] _tag = data.Tags.Split(';');
            Tags.Clear();

            foreach (var item in _tag)
            {
                if (item != "")
                {
                    Tags.Add(item);

                }
            }
            await TagsChanged.InvokeAsync(Tags);
            StateHasChanged();



            if (data == null)
            {
                snackBar.Add("اطلاعات مورد نظر یافت نشد", Severity.Error);
                nav.NavigateTo("/QuestionsList");
                return;
            }
        }
        catch
        {
            snackBar.Add("خطا در دریافت اطلاعات ", Severity.Error);
            nav.NavigateTo("/QuestionsList");
        }
    }

    async Task Save()
    {
        try
        {


            string[] _tag = Tags.ToArray();
            string tag_ = "";
            foreach (var item in _tag)
            {
                tag_ += item + ";";
            }
            data.Tags = tag_;

            HttpResponseMessage response;

            if (Cls_global.IsEdit)
            {
                response = await _httpClient.PutAsJsonAsync($"api/Question", data);
            }
            else
            {
                response = await _httpClient.PostAsJsonAsync("api/Question", data);
            }

            if (response.IsSuccessStatusCode)
            {
                snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
                snackBar.Add(Cls_global.IsEdit ? "اطلاعات با موفقیت بروزرسانی شد" : "اطلاعات با موفقیت ثبت شد", Severity.Success);

            }
            else
            {
                snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
                snackBar.Add("عملیات با خطا مواجه شد. لطفاً مجدد تلاش کنید", Severity.Error);
            }
        }
        catch
        {


        }
    }

    private async Task<IEnumerable<string>> Search1(string value, CancellationToken token)
    {

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _tags;
        return _tags.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Take(10);
    }
    protected override async Task OnInitializedAsync()
    {


        if (Cls_global.IsEdit)
        {
            await LoadData();

        }
        else
        {
            data.Groups = "گاردنر";
            data.NumberOfOptions = 4;
            data.Gender_specific = "هر دو گروه";
        }
    }

    private async Task AddTagFromInput()
    {
        if (!string.IsNullOrWhiteSpace(_newTag))
        {
            var trimmedTag = _newTag.Trim();

            // بررسی بدون توجه به کوچک/بزرگ بودن حروف
            if (!Tags.Any(t => t.Equals(trimmedTag, StringComparison.OrdinalIgnoreCase)))
            {
                Tags.Add(trimmedTag);
                _newTag = null;
                await TagsChanged.InvokeAsync(Tags);
                StateHasChanged();
            }
            else
            {
                snackBar.Add("تگ تکراری", Severity.Error);
                return;
            }
        }
    }

    private async Task RemoveTag(string tag)
    {
        Tags.Remove(tag);
        await TagsChanged.InvokeAsync(Tags);
        StateHasChanged();
    }

