@page "/Profile"
@inject IJSRuntime JsRuntime
@inject MudBlazor.ISnackbar snackBar
@using System.Globalization
@inject NavigationManager nav
@using Microsoft.AspNetCore.Authorization
@using NovinApp.Client.Component
@using NovinApp.Client.Service
@using NovinApp.Shared
@inject IDialogService Dialog
@inject HttpClient _httpClient
@inject UserProfileStateService UserProfileState
@attribute [Authorize]

<PageHeader Title="اطلاعات حساب کاربری"
            Subtitle="مشاهده و ویرایش مشخصات فردی، تحصیلی و تصویر پروفایل"
            Icon="@Icons.Material.Filled.AccountCircle"
            BannerClass="banner-primary">
    <MudChip T="string" Color="Color.Surface" Variant="Variant.Outlined" Class="text-white">
        نقش: @(data.Rool ?? "کاربر")
    </MudChip>
</PageHeader>

<EditForm Model="@data" OnValidSubmit="Save">
    <MudPaper Elevation="0" Class="modern-card pa-3 pa-sm-5 mt-2">
        <DataAnnotationsValidator />
        <MudGrid Class="mt-1 pa-4">

            @* ===== بخش ۱: عکس پروفایل ===== *@
            <MudItem md="12" xs="12">
                <MudCard Elevation="0" Class="d-flex flex-column align-center justify-center pa-4">
                    <MudText Align="Align.Center" Class="rounded-circle mb-4">
                        @if (!string.IsNullOrEmpty(data.pic))
                        {
                            <MudImage Src="@data.pic" Class="rounded-circle" Elevation="5" Height="130" Width="130" />
                        }
                        else
                        {
                            <MudImage Src="img/no_pic.jpg" Class="rounded-circle" Elevation="5" Width="130" Height="130" />
                        }
                    </MudText>

                    <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                        <label for="fileinput" class="label-wrapper">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Size="Size.Small"
                                       HtmlTag="span">
                                بارگذاری عکس
                            </MudButton>
                            <InputFile id="fileinput" accept="image/*" OnChange="OnChange_pic" class="custom-input-hide" />
                        </label>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   OnClick="Del_pic">
                            حذف عکس
                        </MudButton>
                    </MudStack>
                </MudCard>
            </MudItem>

            <MudItem md="12" xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-2" />
            </MudItem>

            @* ===== بخش ۲: اطلاعات هویتی ===== *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="ml-1" />
                    اطلاعات هویتی
                </MudText>
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="نام کاربری"
                              @bind-Value="@data.fname"
                              For="@(() => data.fname)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="نام کاربری الزامی است"
                              MaxLength="100"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField ReadOnly Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="کد ملی"
                              @bind-Value="@data.code_meli"
                              For="@(() => data.code_meli)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="کد ملی الزامی است"
                              MaxLength="20"
                              Mask="@(new RegexMask(@"\d{1,10}"))"
                              AdornmentIcon="@Icons.Material.Filled.CreditCard"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="6" xs="12">
                <MudSelect T="string"
                           Style="text-align:right"
                           Variant="Variant.Outlined"
                           Label="جنسیت"
                           @bind-Value="@data.gender"
                           For="@(() => data.gender)"
                           Margin="Margin.Dense"
                           Required="true"
                           RequiredError="انتخاب جنسیت الزامی است"
                           AdornmentIcon="@Icons.Material.Filled.Wc"
                           Adornment="Adornment.Start">
                    <MudSelectItem Value=@("مرد")>مرد</MudSelectItem>
                    <MudSelectItem Value=@("زن")>زن</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="شماره تماس"
                              @bind-Value="@data.mobile"
                              For="@(() => data.mobile)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="شماره تماس الزامی است"
                              MaxLength="50"
                              Mask="@(new RegexMask(@"\d{1,11}"))"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="12" xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-2" />
            </MudItem>

            @* ===== بخش ۳: اطلاعات امنیتی و دسترسی ===== *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-3 mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="ml-1" />
                    اطلاعات امنیتی و دسترسی
                </MudText>
            </MudItem>

            <MudItem md="6" xs="12" >
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="رمز عبور"
                              @bind-Value="@data.pass"
                              For="@(() => data.pass)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="رمز عبور الزامی است"
                              MaxLength="100"
                              InputType="InputType.Password"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="6" xs="12">
                <MudSelect T="string" ReadOnly
                           Style="text-align:right"
                           Variant="Variant.Outlined"
                           Label="نقش کاربری"
                           @bind-Value="@data.Rool"
                           For="@(() => data.Rool)"
                           Margin="Margin.Dense"
                           Required="true"
                           RequiredError="انتخاب نقش الزامی است"
                           AdornmentIcon="@Icons.Material.Filled.AdminPanelSettings"
                           Adornment="Adornment.Start">
                    <MudSelectItem Value=@("دانش آموز")>
                        <MudStack Row="true" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                            <MudText>دانش آموز</MudText>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value=@("مشاور")>
                        <MudStack Row="true" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                            <MudText>مشاور</MudText>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value=@("مدیر")>
                        <MudStack Row="true" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                            <MudText>مدیر</MudText>
                        </MudStack>
                    </MudSelectItem>
                </MudSelect>
            </MudItem>

            @* فیلد وضعیت فعال - تمام عرض *@
            <MudItem  md="6" xs="12">
                <MudSwitch T="bool" ReadOnly="true"
                           @bind-Value="@isActive"
                           Color="Color.Success"
                           Label="کاربر فعال باشد"
                           Class="mt-2" />
            </MudItem>

            @* ===== بخش ۴: دکمه‌های ثبت و انصراف ===== *@
            <MudItem xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-3" />
                <MudCardActions Class="d-flex justify-end flex-wrap gap-2 pa-0">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Class="ml-2"
                               ButtonType="ButtonType.Submit"
                               Size="Size.Large">
                        @("بروزرسانی")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="GoToBack"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Large">
                        انصراف
                    </MudButton>
                </MudCardActions>
            </MudItem>

        </MudGrid>
    </MudPaper>
</EditForm>

<style>
    .label-wrapper:hover {
        cursor: pointer;
    }

    .custom-input-hide {
        width: 0;
        height: 0;
        overflow: hidden;
    }
</style>
@code {
  

    private bool isActive = true;
    protected IEnumerable<User> data_list = new List<User>();
    private string _searchString = "";
    private int selectedRowNumber = -1;
    private int lastRowNumber = -1;
    private bool NoEdite = true;
    User data = new User();
    public async Task<bool> OpenDialog(string txt)
    {

        var parameters = new DialogParameters();
        parameters.Add("mytext", txt);
        var dialog = await Dialog.ShowAsync<Alert_qoustion>("", parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            return true;
        }
        else
        {
            return false;

        }
    }


    ImageFile filesBase64_pic = new ImageFile();

    async Task OnChange_pic(InputFileChangeEventArgs e)
    {
        if (e.File.Size / 1024 > 1024)
        {
            snackBar.Add("سایز عکس بیش از انداره بزرگ می باشد ", Severity.Warning);
            return;
        }
        var file = e.File; // get the files selected by the users
        //   var resizedFile = await file.RequestImageFileAsync(e.File.ContentType, int.MaxValue, int.MaxValue); // resize the image file
        var buf = new byte[file.Size]; // allocate a buffer to fill with the file's data
        using (var stream = file.OpenReadStream(int.MaxValue))
        {
            await stream.ReadAsync(buf); // copy the stream to the buffer
        }
        data.pic = $"data:{file.ContentType}; base64,{Convert.ToBase64String(buf)}";
    }
    void Del_pic()
    {
        data.pic = null;
    }
    protected override async Task OnParametersSetAsync()
    {
        await Btn_Refresh();
        await InvokeAsync(() => StateHasChanged());
    }
    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnChange += StateHasChanged;

        if (!UserProfileState.IsLoaded)
            await UserProfileState.LoadUserAsync();

    }

    protected async Task Save()
    {


        var respon = await _httpClient.PutAsJsonAsync("api/User", data);
        if (respon.IsSuccessStatusCode)
        {
            snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
            snackBar.Add("اطلاعات با موفقیت بروز رسانی شد", Severity.Success);
            data = new User();
            nav.NavigateTo("/Home");
        }
        else
        {

            snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
            snackBar.Add("ویرایش با خطا مواجه شد." + Environment.NewLine + "اطلاعات مورد نظر تغییر داشته مجدد امتحان کنید", Severity.Error);
            //  personel = new Personel();

        }

    }
    async Task Btn_Refresh()
    {
        try
        {
            data = await _httpClient.GetFromJsonAsync<User>($"api/User/{UserProfileState.CurrentUser.Id}");
            if (data == null)
            {
                await OpenDialog("خطا در دریافت اطلاعات مجدد امتحان کنید").ConfigureAwait(false);
                nav.NavigateTo("/Home");
            }
            isActive = data.active;

            await InvokeAsync(() => StateHasChanged());

        }
        catch
        {

            nav.NavigateTo("/Home");
        }

    }
    void GoToBack()
    {
        nav.NavigateTo("/Home");
    }

}