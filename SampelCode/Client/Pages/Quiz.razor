</style>

@code {
    [Parameter] public string? TestType { get; set; }
    [SupplyParameterFromQuery] public int? studentId { get; set; }

    private string ActiveTestType => string.IsNullOrWhiteSpace(TestType) ? PsychologyTestTypes.Holland : TestType;
    private List<TestQuestion> questions = new();
    private int currentIndex = 0;
    private TestQuestion? currentQuestion;
    private bool isFinished = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool alreadyTaken = false;
    private string currentReportTitle = "آزمون روانشناسی و استعدادسنجی";
    private TestAnalysisReport? testReport;
    private PsychologyTestResult? savedDbResult;
    private ComprehensiveCareerReport? comprehensiveReport;
    private int selectedReportTab = 0;

    private double ProgressPercent => questions.Count > 0 ? (double)(currentIndex + 1) / questions.Count * 100 : 0;


    protected override async Task OnInitializedAsync()
    {
        if (!UserProfileState.IsLoaded)
            await UserProfileState.LoadUserAsync();

        var user = UserProfileState.CurrentUser;
        int targetUserId = (studentId != null && studentId > 0) ? studentId.Value : (user?.Id ?? 0);

        if (targetUserId > 0)
        {
            // بررسی اینکه آیا دانش‌آموز قبلاً در این آزمون شرکت کرده است؟
            var status = await testService.CheckStatusAsync(targetUserId, ActiveTestType);
            if (status.hasTaken && status.result != null)
            {
                alreadyTaken = true;
                savedDbResult = status.result;
                isFinished = true;
                LoadReportFromDbResult(status.result);
                isLoading = false;
                return;
            }
        }

        // اگر شرکت نکرده، سوالات آزمون بارگذاری می‌شود
        questions = testService.GetQuestions(ActiveTestType);
        if (questions.Any())
        {
            currentQuestion = questions[currentIndex];
            currentReportTitle = ActiveTestType switch
            {
                PsychologyTestTypes.Gardner => "آزمون هوش‌های چندگانه گاردنر (۸۰ سوال)",
                PsychologyTestTypes.NEO => "آزمون پنج عامل بزرگ شخصیت نئو (۶۰ سوال)",
                PsychologyTestTypes.Cattell => "آزمون ۱۶ عاملی شخصیت کتل (Cattell 16PF)",
                PsychologyTestTypes.Clifton => "آزمون استعدادیابی و توانمندی‌های کلیفتون (Clifton Strengths)",
                _ => "آزمون رغبت‌سنجی شغلی و تحصیلی هالند"
            };
        }

        isLoading = false;
    }

    private async Task SelectScoreAndAdvance(int score)
    {
        if (currentQuestion == null) return;
        currentQuestion.SelectedScore = score;
        StateHasChanged();

        // تاخیر کوتاه برای نمایش انیمیشن انتخاب و اطمینان کاربر
        await Task.Delay(180);

        if (currentIndex < questions.Count - 1)
        {
            currentIndex++;
            currentQuestion = questions[currentIndex];
            StateHasChanged();
        }
    }

    private string GetOptionClass(int score)
    {
        return currentQuestion?.SelectedScore == score ? "option-card-selected" : "option-card";
    }

    private void NextQuestion()
    {
        if (currentIndex < questions.Count - 1)
        {
            currentIndex++;
            currentQuestion = questions[currentIndex];
        }
    }

    private void PrevQuestion()
    {
        if (currentIndex > 0)
        {
            currentIndex--;
            currentQuestion = questions[currentIndex];
        }
    }

    private async Task FinishExam()
    {
        isSaving = true;
        try
        {
            // ۱. محاسبه گزارش آزمون
            testReport = testService.CalculateReport(ActiveTestType, questions);

            var user = UserProfileState.CurrentUser;
            if (user == null)
            {
                snackBar.Add("خطا: اطلاعات کاربری یافت نشد. لطفاً مجدداً وارد شوید.", Severity.Error);
                return;
            }

            // ۲. آماده‌سازی مدل جهت ذخیره در دیتابیس
            var dbModel = new PsychologyTestResult
            {
                UserId = user.Id,
                StudentNationalCode = user.code_meli,
                StudentName = user.fname,
                Id_Moshaver = user.Id_Moshaver,
                TestType = ActiveTestType,
                TestTitle = testReport.TestTitle,
                PrimaryScore = testReport.PrimaryCode?.Length > 500 ? testReport.PrimaryCode[..500] : testReport.PrimaryCode,
                ScoresJson = JsonSerializer.Serialize(testReport.Dimensions),
                AnalysisText = testReport.SummaryAnalysis,
                HighSchoolBranchesJson = JsonSerializer.Serialize(testReport.HighSchoolBranches),
                UniversityMajorsJson = JsonSerializer.Serialize(testReport.UniversityMajors),
                SuitableCareersJson = JsonSerializer.Serialize(testReport.SuitableCareers),
                CreatedAt = DateTime.Now
            };

            // ۳. ذخیره کارنامه در دیتابیس
            savedDbResult = await testService.SaveResultAsync(dbModel);

            // ۴. دریافت و ذخیره نظریه هوش مصنوعی
            if (savedDbResult != null)
            {
                var aiAdvice = await testService.GenerateAiRecommendationAsync(savedDbResult, user);
                testReport.AiGuidance = aiAdvice;
            }

            comprehensiveReport = testService.BuildComprehensiveReport(testReport, user, savedDbResult, user.Moshaver);

            isFinished = true;
            snackBar.Add("آزمون شما با موفقیت ثبت شد و کارنامه صادر گردید!", Severity.Success);
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا در ثبت آزمون: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void LoadReportFromDbResult(PsychologyTestResult r)
    {
        try
        {
            testReport = new TestAnalysisReport
            {
                TestType = r.TestType,
                TestTitle = r.TestTitle,
                PrimaryCode = r.PrimaryScore ?? "",
                SummaryAnalysis = r.AnalysisText,
                AiGuidance = r.AiRecommendation,
                Dimensions = !string.IsNullOrEmpty(r.ScoresJson)
                    ? JsonSerializer.Deserialize<List<TestScoreDimension>>(r.ScoresJson) ?? new()
                    : new(),
                HighSchoolBranches = !string.IsNullOrEmpty(r.HighSchoolBranchesJson)
                    ? JsonSerializer.Deserialize<List<string>>(r.HighSchoolBranchesJson) ?? new()
                    : new(),
                UniversityMajors = !string.IsNullOrEmpty(r.UniversityMajorsJson)
                    ? JsonSerializer.Deserialize<List<string>>(r.UniversityMajorsJson) ?? new()
                    : new(),
                SuitableCareers = !string.IsNullOrEmpty(r.SuitableCareersJson)
                    ? JsonSerializer.Deserialize<List<string>>(r.SuitableCareersJson) ?? new()
                    : new()
            };

            comprehensiveReport = testService.BuildComprehensiveReport(testReport, UserProfileState.CurrentUser, r, UserProfileState.CurrentUser?.Moshaver);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deserializing report: {ex.Message}");
        }
    }


    private void BackToProducts() => nav.NavigateTo("/Products");

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}

