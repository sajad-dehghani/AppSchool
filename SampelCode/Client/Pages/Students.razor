@page "/Students"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NovinApp.Client.Service
@using NovinApp.Client.Component
@using NovinApp.Shared.Constants
@using NovinApp.Shared.DTOs.Common
@using NovinApp.Shared.DTOs.Consultants
@using NovinApp.Shared.DTOs.Schools
@using NovinApp.Shared.DTOs.Students
@inject HttpClient _http
@inject ISnackbar snackBar
@inject IDialogService dialogService
@inject UserProfileStateService UserProfileState
@attribute [Authorize]

<div class="page-banner banner-primary mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                <MudIcon Icon="@Icons.Material.Filled.School" Class="ml-2 align-middle" />
                @(UserProfileState.IsConsultant ? "دانش‌آموزان تحت نظر من" : "مدیریت و لیست پرونده دانش‌آموزان")
            </MudText>
            <MudText Typo="Typo.body2" Class="text-white mt-1" Style="opacity: 0.9;">
                مشاهده اطلاعات هویتی و تحصیلی، انتساب به مدرسه و مشاور، و دسترسی به سوابق آموزشی
            </MudText>
        </div>
        @if (UserProfileState.IsSystemAdmin || UserProfileState.IsSchoolManager)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Surface" StartIcon="@Icons.Material.Filled.PersonAdd"
                       Class="text-primary font-weight-bold" OnClick="OpenCreateDialog">
                ثبت دانش‌آموز جدید
            </MudButton>
        }
    </div>
</div>

<MudPaper Elevation="0" Class="modern-card pa-4">
    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudTextField @bind-Value="searchString" Placeholder="جستجوی نام یا کد ملی..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="max-w-250" />

            @if (UserProfileState.IsSystemAdmin)
            {
                <MudSelect T="int?" @bind-Value="selectedSchoolFilter" Label="فیلتر مدرسه" Dense="true"
                           Margin="Margin.Dense" Variant="Variant.Outlined" Class="max-w-200" Clearable="true"
                           SelectedValuesChanged="LoadStudents">
                    @foreach (var s in schools)
                    {
                        <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?" @bind-Value="selectedConsultantFilter" Label="فیلتر مشاور" Dense="true"
                           Margin="Margin.Dense" Variant="Variant.Outlined" Class="max-w-200" Clearable="true"
                           SelectedValuesChanged="LoadStudents">
                    @foreach (var c in consultants)
                    {
                        <MudSelectItem Value="@((int?)c.Id)">@c.FullName</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
            تعداد کل: @students.Count دانش‌آموز
        </MudChip>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center align-center my-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.subtitle2" Class="ms-3">در حال بارگذاری پرونده‌های دانش‌آموزان...</MudText>
        </div>
    }
    else if (!FilteredStudents.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="rounded-lg my-4">
            هیچ دانش‌آموزی یافت نگردید یا با فیلترهای انتخابی تطابق ندارد.
        </MudAlert>
    }
    else
    {
        <MudTable Items="@FilteredStudents" Hover="true" Striped="true" Elevation="0" Dense="true">
            <HeaderContent>
                <MudTh>نام دانش‌آموز</MudTh>
                <MudTh>کد ملی</MudTh>
                <MudTh>پایه و رشته</MudTh>
                <MudTh>مدرسه</MudTh>
                <MudTh>مشاور تحصیلی</MudTh>
                <MudTh>تلفن</MudTh>
                <MudTh>وضعیت</MudTh>
                @if (UserProfileState.IsSystemAdmin || UserProfileState.IsSchoolManager)
                {
                    <MudTh Class="text-center">عملیات</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="نام دانش‌آموز">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <span class="font-weight-bold text-primary">@context.FullName</span>
                            @if (!string.IsNullOrEmpty(context.FatherName))
                            {
                                <span class="text-muted d-block small">فرزند: @context.FatherName</span>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="کد ملی">@context.NationalCode</MudTd>
                <MudTd DataLabel="پایه و رشته">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Dark">
                        @(context.GradeLevel ?? "دوازدهم") - @(context.FieldOfStudy ?? "تجربی")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="مدرسه">
                    <span class="text-secondary font-weight-bold">@(context.SchoolName ?? "ثبت‌نشده")</span>
                </MudTd>
                <MudTd DataLabel="مشاور">
                    @if (!string.IsNullOrEmpty(context.ConsultantName))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                            @context.ConsultantName
                        </MudChip>
                    }
                    else
                    {
                        <span class="text-muted small">بدون مشاور</span>
                    }
                </MudTd>
                <MudTd DataLabel="تلفن">@(context.PhoneNumber ?? "---")</MudTd>
                <MudTd DataLabel="وضعیت">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">فعال</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">غیرفعال</MudChip>
                    }
                </MudTd>
                @if (UserProfileState.IsSystemAdmin || UserProfileState.IsSchoolManager)
                {
                    <MudTd DataLabel="عملیات" Class="text-center">
                        <MudTooltip Text="انتساب مدرسه و مشاور">
                            <MudIconButton Icon="@Icons.Material.Filled.AssignmentInd" Color="Color.Info" Size="Size.Small"
                                           OnClick="@(() => OpenAssignDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="ویرایش دانش‌آموز">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context))" />
                        </MudTooltip>
                        @if (UserProfileState.IsSystemAdmin)
                        {
                            <MudTooltip Text="حذف دانش‌آموز">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteStudent(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@* دیالوگ ثبت دانش‌آموز جدید *@
<MudDialog @bind-Visible="isCreateDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">ثبت پرونده دانش‌آموز جدید</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@createModel" OnValidSubmit="SaveCreateStudent">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2" Class="pt-2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="createModel.FullName" Label="نام و نام خانوادگی" Variant="Variant.Outlined"
                                  Required="true" For="@(() => createModel.FullName)" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="createModel.NationalCode" Label="کد ملی (۱۰ رقم)" Variant="Variant.Outlined"
                                  Required="true" For="@(() => createModel.NationalCode)" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="createModel.Password" Label="کلمه عبور" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Required="true" For="@(() => createModel.Password)" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="createModel.FatherName" Label="نام پدر" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="createModel.PhoneNumber" Label="تلفن همراه" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="createModel.StudentCode" Label="شماره دانش‌آموزی" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="createModel.GradeLevel" Label="پایه تحصیلی" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("پایه دهم")">پایه دهم</MudSelectItem>
                        <MudSelectItem Value="@("پایه یازدهم")">پایه یازدهم</MudSelectItem>
                        <MudSelectItem Value="@("پایه دوازدهم")">پایه دوازدهم</MudSelectItem>
                        <MudSelectItem Value="@("فارغ‌التحصیل")">فارغ‌التحصیل / پشت کنکور</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="createModel.FieldOfStudy" Label="رشته تحصیلی" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("علوم تجربی")">علوم تجربی</MudSelectItem>
                        <MudSelectItem Value="@("ریاضی و فیزیک")">ریاضی و فیزیک</MudSelectItem>
                        <MudSelectItem Value="@("علوم انسانی")">علوم انسانی</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (UserProfileState.IsSystemAdmin)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="createModel.SchoolId" Label="مدرسه" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var s in schools)
                            {
                                <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="createModel.ConsultantId" Label="مشاور تحصیلی" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var c in consultants)
                        {
                            <MudSelectItem Value="@((int?)c.Id)">@c.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isCreateDialogOpen = false)" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreateStudent" Disabled="isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>در حال ذخیره...</span>
            }
            else
            {
                <span>ثبت دانش‌آموز</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

