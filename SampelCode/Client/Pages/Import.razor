@page "/Import"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using NovinApp.Client.Service
@using NovinApp.Client.Component
@using NovinApp.Shared.Constants
@using NovinApp.Shared.DTOs.Common
@using NovinApp.Shared.DTOs.Import
@using NovinApp.Shared.DTOs.Schools
@using NovinApp.Shared.DTOs.Consultants
@using NovinApp.Shared.Enums
@inject HttpClient _http
@inject ISnackbar snackBar
@inject IDialogService dialogService
@inject UserProfileStateService UserProfileState
@attribute [Authorize(Roles = $"{UserRoles.SystemAdmin},{UserRoles.SchoolManager},{UserRoles.Consultant}")]

<div class="page-banner banner-primary mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="ml-2 align-middle" />
                ایمپورت اطلاعات از فایل اکسل
            </MudText>
            <MudText Typo="Typo.body2" Class="text-white mt-1" Style="opacity: 0.9;">
                بارگذاری لیست دانش‌آموزان یا نتایج آزمون از فایل اکسل (xlsx)
            </MudText>
        </div>
    </div>
</div>

<MudTabs Elevation="0" Rounded="true" Outlined="true" ApplyEffectsToContainer="true" Class="modern-card">
    @* تب ایمپورت دانش‌آموزان *@
    <MudTabPanel Text="ایمپورت دانش‌آموزان" Icon="@Icons.Material.Filled.People">
        <MudPaper Elevation="0" Class="pa-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                <strong>فرمت فایل اکسل:</strong> ردیف اول باید سرستون باشد. ستون‌های قابل شناسایی:
                <br/>نام و نام خانوادگی | کد ملی | نام پدر | تلفن همراه | پایه تحصیلی | رشته تحصیلی | شماره دانش‌آموزی
                <br/><strong>ستون «کد ملی» الزامی است.</strong> کلمه عبور پیش‌فرض: <code>Novin@("@")کدملی</code>
            </MudAlert>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6" md="4">
                    <MudFileUpload T="IBrowserFile" Accept=".xlsx,.xls" FilesChanged="OnStudentFileSelected" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                                       FullWidth="true" Class="py-3">
                                @(studentFile != null ? studentFile.Name : "انتخاب فایل اکسل")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudItem>

                @if (UserProfileState.IsSystemAdmin)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="int?" @bind-Value="selectedSchoolId" Label="مدرسه مقصد (اختیاری)"
                                   Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                            @foreach (var s in schools)
                            {
                                <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="selectedConsultantId" Label="مشاور تحصیلی (اختیاری)"
                               Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                        @foreach (var c in consultants)
                        {
                            <MudSelectItem Value="@((int?)c.Id)">@c.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="DuplicateHandlingMode" @bind-Value="studentDuplicateMode" Label="برخورد با تکراری‌ها"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="DuplicateHandlingMode.Skip">رد کردن (Skip)</MudSelectItem>
                        <MudSelectItem Value="DuplicateHandlingMode.Update">به‌روزرسانی (Update)</MudSelectItem>
                        <MudSelectItem Value="DuplicateHandlingMode.Error">خطا (Error)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload"
                               OnClick="UploadStudents" Disabled="@(studentFile == null || isUploading)" Class="px-6">
                        @if (isUploading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>در حال پردازش...</span>
                        }
                        else
                        {
                            <span>شروع ایمپورت دانش‌آموزان</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (studentResult != null)
            {
                <ImportResultView Result="studentResult" />
            }
        </MudPaper>
    </MudTabPanel>

    @* تب ایمپورت نتایج آزمون *@
    <MudTabPanel Text="ایمپورت نتایج آزمون" Icon="@Icons.Material.Filled.Assessment">
        <MudPaper Elevation="0" Class="pa-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                <strong>فرمت فایل اکسل:</strong> ردیف اول سرستون. ستون «کد ملی» الزامی.
                <br/>ستون‌های ثابت: کد ملی | درصد کل | تراز کل
                <br/><strong>هر ستون دیگر به‌عنوان نام درس شناسایی شده و مقدار آن درصد درس است.</strong>
            </MudAlert>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6" md="4">
                    <MudFileUpload T="IBrowserFile" Accept=".xlsx,.xls" FilesChanged="OnExamFileSelected" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                                       FullWidth="true" Class="py-3">
                                @(examFile != null ? examFile.Name : "انتخاب فایل نتایج آزمون")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int" @bind-Value="selectedExamId" Label="انتخاب آزمون (الزامی)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        @foreach (var e in exams)
                        {
                            <MudSelectItem Value="@e.Id">@e.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="DuplicateHandlingMode" @bind-Value="examDuplicateMode" Label="برخورد با تکراری‌ها"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="DuplicateHandlingMode.Skip">رد کردن</MudSelectItem>
                        <MudSelectItem Value="DuplicateHandlingMode.Update">جایگزینی</MudSelectItem>
                        <MudSelectItem Value="DuplicateHandlingMode.Error">خطا</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Upload"
                               OnClick="UploadExamResults" Disabled="@(examFile == null || selectedExamId == 0 || isUploading)" Class="px-6">
                        @if (isUploading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>در حال پردازش...</span>
                        }
                        else
                        {
                            <span>شروع ایمپورت نتایج آزمون</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (examResult != null)
            {
                <ImportResultView Result="examResult" />
            }
        </MudPaper>
    </MudTabPanel>

    @* تب تاریخچه *@
    <MudTabPanel Text="تاریخچه ایمپورت‌ها" Icon="@Icons.Material.Filled.History">
        <MudPaper Elevation="0" Class="pa-4">
            @if (isLoadingHistory)
            {
                <div class="d-flex justify-center my-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else if (!history.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">هیچ سابقه ایمپورتی ثبت نشده است.</MudAlert>
            }
            else
            {
                <MudTable Items="@history" Hover="true" Striped="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>نام فایل</MudTh>
                        <MudTh>آزمون</MudTh>
                        <MudTh>وضعیت</MudTh>
                        <MudTh>کل</MudTh>
                        <MudTh>موفق</MudTh>
                        <MudTh>خطا</MudTh>
                        <MudTh>تاریخ</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FileName</MudTd>
                        <MudTd>@(context.ExamTitle ?? "دانش‌آموزان")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                                @GetStatusText(context.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd>@context.TotalRows</MudTd>
                        <MudTd><span class="text-success font-weight-bold">@context.SuccessfulRows</span></MudTd>
                        <MudTd><span class="text-error font-weight-bold">@context.FailedRows</span></MudTd>
                        <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // === فایل‌ها و تنظیمات ===
    private IBrowserFile? studentFile;
    private IBrowserFile? examFile;
    private int? selectedSchoolId;
    private int? selectedConsultantId;
    private int selectedExamId;
    private DuplicateHandlingMode studentDuplicateMode = DuplicateHandlingMode.Skip;
    private DuplicateHandlingMode examDuplicateMode = DuplicateHandlingMode.Skip;
    private bool isUploading = false;

    // === نتایج ===
    private ImportResultDto? studentResult;
    private ImportResultDto? examResult;

    // === داده‌های کمکی ===
    private List<SchoolDto> schools = new();
    private List<ConsultantDto> consultants = new();
    private List<ExamListItem> exams = new();
    private List<ImportSessionListDto> history = new();
    private bool isLoadingHistory = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadHistory();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var schoolRes = await _http.GetFromJsonAsync<ApiResponse<List<SchoolDto>>>("api/schools");
            if (schoolRes?.Success == true && schoolRes.Data != null) schools = schoolRes.Data;

            var consRes = await _http.GetFromJsonAsync<ApiResponse<List<ConsultantDto>>>("api/consultants");
            if (consRes?.Success == true && consRes.Data != null) consultants = consRes.Data;

            // لود لیست آزمون‌ها — اگر endpoint موجود نباشد خالی بماند
            try
            {
                var examRes = await _http.GetFromJsonAsync<ApiResponse<List<ExamListItem>>>("api/exams");
                if (examRes?.Success == true && examRes.Data != null) exams = examRes.Data;
            }
            catch { }
        }
        catch { }
    }

    private async Task LoadHistory()
    {
        isLoadingHistory = true;
        try
        {
            var res = await _http.GetFromJsonAsync<ApiResponse<List<ImportSessionListDto>>>("api/import/history");
            if (res?.Success == true && res.Data != null) history = res.Data;
        }
        catch { }
        finally { isLoadingHistory = false; }
    }

    private void OnStudentFileSelected(IBrowserFile file) => studentFile = file;
    private void OnExamFileSelected(IBrowserFile file) => examFile = file;

    private async Task UploadStudents()
    {
        if (studentFile == null) return;
        isUploading = true;
        studentResult = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(studentFile.OpenReadStream(10 * 1024 * 1024));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", studentFile.Name);

            string url = $"api/import/students?duplicateHandling={studentDuplicateMode}";
            if (selectedSchoolId.HasValue) url += $"&schoolId={selectedSchoolId.Value}";
            if (selectedConsultantId.HasValue) url += $"&consultantId={selectedConsultantId.Value}";

            var response = await _http.PostAsync(url, content);
            var apiRes = await response.Content.ReadFromJsonAsync<ApiResponse<ImportResultDto>>();
            if (apiRes?.Data != null)
            {
                studentResult = apiRes.Data;
                snackBar.Add(apiRes.Message ?? "ایمپورت انجام شد.", studentResult.Status == ImportStatus.Completed ? Severity.Success : Severity.Warning);
                await LoadHistory();
            }
            else
            {
                snackBar.Add(apiRes?.Message ?? "خطا در ایمپورت", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطای سیستمی: {ex.Message}", Severity.Error);
        }
        finally { isUploading = false; }
    }

    private async Task UploadExamResults()
    {
        if (examFile == null || selectedExamId == 0) return;
        isUploading = true;
        examResult = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(examFile.OpenReadStream(10 * 1024 * 1024));
            streamContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", examFile.Name);

            string url = $"api/import/exam-results?examId={selectedExamId}&duplicateHandling={examDuplicateMode}";

            var response = await _http.PostAsync(url, content);
            var apiRes = await response.Content.ReadFromJsonAsync<ApiResponse<ImportResultDto>>();
            if (apiRes?.Data != null)
            {
                examResult = apiRes.Data;
                snackBar.Add(apiRes.Message ?? "ایمپورت نتایج انجام شد.", examResult.Status == ImportStatus.Completed ? Severity.Success : Severity.Warning);
                await LoadHistory();
            }
            else
            {
                snackBar.Add(apiRes?.Message ?? "خطا در ایمپورت نتایج", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally { isUploading = false; }
    }

    private Color GetStatusColor(ImportStatus status) => status switch
    {
        ImportStatus.Completed => Color.Success,
        ImportStatus.PartialFailure => Color.Warning,
        ImportStatus.Failed => Color.Error,
        ImportStatus.Processing => Color.Info,
        _ => Color.Default
    };

    private string GetStatusText(ImportStatus status) => status switch
    {
        ImportStatus.Completed => "موفق",
        ImportStatus.PartialFailure => "ناقص",
        ImportStatus.Failed => "ناموفق",
        ImportStatus.Processing => "در حال پردازش",
        ImportStatus.Pending => "در انتظار",
        _ => "نامشخص"
    };

    // DTO ساده برای لیست آزمون‌ها
    public class ExamListItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
    }
}
