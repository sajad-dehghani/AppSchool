@inherits LayoutComponentBase
@using MudBlazor
@using NovinApp.Client.Service
@using MudBlazor
@inject NavigationManager Navigation
@inject UserProfileStateService UserProfileState

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="@my" IsDarkMode="@isdark" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <!-- Top AppBar -->
        <MudAppBar Elevation="4" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer"  />

            <MudText Typo="Typo.h6" Class="ml-2">
                سامانه مشاور نوین
            </MudText>

            <MudSpacer />
            <MudToggleIconButton @bind-Toggled="@isdark" Class="text-white"
                                 Icon="@Icons.Material.Outlined.DarkMode" Color="@Color.Inherit" title="تبدیل به حالت تاریک"
                                 ToggledIcon="@Icons.Material.Outlined.LightMode" ToggledColor="@Color.Inherit" />

            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
                <MudMenuItem Icon="@Icons.Material.Filled.AccountBox" Href="/Profile">اطلاعات پروفایل</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Password" Href="/Frm_Pass">تغییر کلمه عبور</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" iconcolor="Color.Error"  Href="/logout">خروج</MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <!-- Sidebar -->
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="3"
                   Width="280px"
                   ClipMode="DrawerClipMode.Always">

            <NavMenu />   

        </MudDrawer>

        <!-- Main Content -->
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>

    </MudLayout>

</MudRTLProvider>

@code {
    bool isdark = false;
    MudTheme my = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1976D2",
            PrimaryDarken = "#0D47A1",
            Secondary = "#26A69A",
            AppbarBackground = "#1565C0",
            Background = "#F5F7FB",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#42A5F5",
            Secondary = "#80CBC4",
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1E1E1E",
            AppbarBackground = "#1E1E1E"
        }
    };
    private bool _drawerOpen = true;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnChange += StateHasChanged;

        if (!UserProfileState.IsLoaded)
            await UserProfileState.LoadUserAsync();
    }

    public void Dispose()
    {
        UserProfileState.OnChange -= StateHasChanged;
    }
}
