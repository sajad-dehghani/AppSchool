@using NovinApp.Client.Service
@using NovinApp.Shared
@using NovinApp.Shared.Constants
@inject UserProfileStateService UserProfileState

<MudPaper Elevation="0" Class="sidebar-root">

    @if (UserProfileState.IsLoaded)
    {
        <MudPaper Class="profile-card" Elevation="3">
            <MudText Align="Align.Center">
                @if (UserProfileState.CurrentUser?.pic != null)
                {
                    <MudImage ObjectFit=ObjectFit.Cover Elevation="10" Class="rounded-circle mt-2" Src=@UserProfileState.CurrentUser?.pic Height="100" Width="100" />
                }
                else
                {
                    <MudImage Src="img/no_pic.jpg" Class="rounded-circle" Elevation="5" Width=100 Height="100" />
                }
            </MudText>
            <MudText Typo="Typo.subtitle1" Class="mt-2 font-weight-bold">@UserProfileState.CurrentUser?.fname</MudText>

            <MudGrid Class="justify-center mt-2">
                <MudText Typo="Typo.subtitle1" Class="mt-2">
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary">@UserProfileState.CurrentUser?.code_meli</MudChip>
                </MudText>
                <MudText Typo="Typo.subtitle1" Class="mt-2">
                    @{
                        var role = UserProfileState.CurrentUser?.Rool ?? "";
                        var normRole = UserRoles.NormalizeRole(role);
                        var chipColor = normRole switch {
                            UserRoles.SystemAdmin => MudBlazor.Color.Error,
                            UserRoles.SchoolManager => MudBlazor.Color.Warning,
                            UserRoles.Consultant => MudBlazor.Color.Tertiary,
                            _ => MudBlazor.Color.Success
                        };
                    }
                    <MudChip T="string" Variant="Variant.Filled" Color="@chipColor">@UserRoles.GetPersianTitle(role)</MudChip>
                </MudText>
            </MudGrid>
        </MudPaper>

        <MudPaper Square="true" Class="pa-1" Elevation="3">
            <MudNavMenu Class="nav-menu">

                <MudNavLink Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary" Href="/Home" Match="NavLinkMatch.All">
                    داشبورد
                </MudNavLink>

                @* === مدیر سیستم === *@
                @if (UserProfileState.IsSystemAdmin)
                {
                    <MudNavGroup Title="مدیریت سیستم" Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Error" Expanded="true">
                        <MudNavLink Icon="@Icons.Material.Filled.LocationCity" IconColor="Color.Warning" Href="/Schools">مدیریت مدارس</MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.SupervisorAccount" IconColor="Color.Tertiary" Href="/Consultants">مدیریت مشاوران</MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Group" IconColor="Color.Primary" Href="/Students">مدیریت دانش‌آموزان</MudNavLink>
                    </MudNavGroup>
                }

                @* === مدیر مدرسه === *@
                @if (UserProfileState.IsSchoolManager)
                {
                    <MudNavLink Icon="@Icons.Material.Filled.School" IconColor="Color.Warning" Href="/SchoolManagerPanel">پنل مدیر مدرسه</MudNavLink>
                }

                @* === مشاور === *@
                @if (UserProfileState.IsConsultant)
                {
                    <MudNavLink Icon="@Icons.Material.Filled.SupervisorAccount" IconColor="Color.Tertiary" Href="/ConsultantPanel">پنل مشاور</MudNavLink>
                }

                @* === دانش آموز === *@
                @if (UserProfileState.IsStudent)
                {
                    <MudNavLink Icon="@Icons.Material.Filled.Person" IconColor="Color.Success" Href="/StudentPanel">پنل من</MudNavLink>
                }

                @* === سامانه برنامه‌ریزی و تقویم مشاوره‌ای (برای همه کاربران مجاز) === *@
                <MudNavLink Icon="@Icons.Material.Filled.CalendarMonth" IconColor="Color.Success" Href="/StudyPlan">
                    @(UserProfileState.IsStudent ? "تقویم و برنامه‌ریزی درسی من" : "تقویم و برنامه‌ریزی تحصیلی")
                </MudNavLink>

                <MudNavLink Icon="@Icons.Material.Filled.Psychology" IconColor="Color.Warning" Href="/Products">آزمون‌های روانشناسی</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.PieChart" IconColor="Color.Info" Href="/StudentReports">کارنامه‌های تحلیلی آزمون</MudNavLink>

                @if (UserProfileState.IsConsultant || UserProfileState.IsSystemAdmin || UserProfileState.IsSchoolManager)
                {
                    <MudNavLink Icon="@Icons.Material.Filled.AssignmentInd" IconColor="Color.Info" Href="/CounselorReports">کارتابل مشاور (ارزیابی‌ها)</MudNavLink>
                }

                <MudNavLink Icon="@Icons.Material.Filled.Assessment" IconColor="Color.Primary" Href="/maping">کارنامه و تحلیل نتایج</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.FormatListNumberedRtl" IconColor="Color.Primary" Href="/QuestionsList">بانک سوالات</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.AttachMoney" IconColor="Color.Primary" Href="/purchase">امور مالی و تراکنش‌ها</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary" Href="/maping">تنظیمات</MudNavLink>

            </MudNavMenu>
        </MudPaper>
    }
</MudPaper>

@code {
    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnChange += StateHasChanged;

        if (!UserProfileState.IsLoaded)
            await UserProfileState.LoadUserAsync();
    }

    public void Dispose()
    {
        UserProfileState.OnChange -= StateHasChanged;
    }
}
