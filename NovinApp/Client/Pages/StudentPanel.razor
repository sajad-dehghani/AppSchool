@page "/StudentPanel"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NovinApp.Client.Service
@using NovinApp.Shared.Constants
@using NovinApp.Shared.DTOs.Common
@using NovinApp.Shared.DTOs.Students
@inject HttpClient _http
@inject ISnackbar snackBar
@inject NavigationManager nav
@inject UserProfileStateService UserProfileState
@attribute [Authorize(Roles = UserRoles.Student)]

<div style="background: linear-gradient(135deg, #4A148C 0%, #6A1B9A 60%, #AB47BC 100%); border-radius: 16px; padding: 20px 24px;" class="mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                <MudIcon Icon="@Icons.Material.Filled.School" Class="ml-2 align-middle" />
                پنل دانش‌آموزی - @(UserProfileState.CurrentUser?.fname ?? "دانش‌آموز گرامی")
            </MudText>
            <MudText Typo="Typo.body2" Class="text-white mt-1" Style="opacity:0.9;">
                مشاهده اطلاعات پرونده تحصیلی، تقویم و برنامه‌ریزی درسی و ثبت گزارش عملکرد
            </MudText>
        </div>
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Surface" Class="font-weight-bold text-secondary"
                       StartIcon="@Icons.Material.Filled.CalendarMonth" Href="/StudyPlan">
                تقویم و برنامه‌ریزی من
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Surface" Size="Size.Small"
                           OnClick="OnInitializedAsync" Title="تازه‌سازی اطلاعات" />
        </div>
    </div>
</div>

@* کارت‌های دسترسی سریع دانش‌آموز *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Class="pa-4 rounded-lg cursor-pointer student-action-card" Style="border-right: 5px solid #6A1B9A;"
                  @onclick="@(() => nav.NavigateTo("/StudyPlan"))">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-secondary">تقویم برنامه‌ریزی تحصیلی</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">مشاهده تکالیف، تست‌ها و ثبت بازخورد روزانه</MudText>
                </div>
                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                </MudAvatar>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Class="pa-4 rounded-lg cursor-pointer student-action-card" Style="border-right: 5px solid #1976D2;"
                  @onclick="@(() => nav.NavigateTo("/StudentReports"))">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-primary">کارنامه‌های تحلیلی آزمون</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">تحلیل تراز، درصدها و روند پیشرفت درسی</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" />
                </MudAvatar>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Class="pa-4 rounded-lg cursor-pointer student-action-card" Style="border-right: 5px solid #2E7D32;"
                  @onclick="@(() => nav.NavigateTo("/Products"))">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-success">آزمون‌های روانشناسی</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">آزمون‌های شخصیت، رغبت‌سنج و مهارت مطالعه</MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" />
                </MudAvatar>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (isLoading)
{
    <div class="d-flex justify-center align-center my-8">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </div>
}
else if (myProfile != null)
{
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Elevation="3" Class="pa-5 rounded-lg" Style="border-top: 5px solid #7B1FA2;">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="ml-2" />
                    اطلاعات پرونده من
                </MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">نام کامل</MudText>
                        <MudText Typo="Typo.body1" Class="font-weight-bold">@myProfile.FullName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">کد ملی</MudText>
                        <MudText Typo="Typo.body1">@myProfile.NationalCode</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">نام پدر</MudText>
                        <MudText Typo="Typo.body1">@(myProfile.FatherName ?? "---")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">تلفن</MudText>
                        <MudText Typo="Typo.body1">@(myProfile.PhoneNumber ?? "---")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">پایه تحصیلی</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                            @(myProfile.GradeLevel ?? "---")
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">رشته تحصیلی</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @(myProfile.FieldOfStudy ?? "---")
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="3" Class="pa-5 rounded-lg mb-4" Style="border-top: 5px solid #1976D2;">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Class="ml-2" />
                            مدرسه من
                        </MudText>
                        @if (!string.IsNullOrEmpty(myProfile.SchoolName))
                        {
                            <MudText Typo="Typo.body1" Class="font-weight-bold text-primary">@myProfile.SchoolName</MudText>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Class="rounded-lg">هنوز به مدرسه‌ای اختصاص داده نشده‌اید.</MudAlert>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Elevation="3" Class="pa-5 rounded-lg" Style="border-top: 5px solid #2E7D32;">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Class="ml-2" />
                            مشاور تحصیلی من
                        </MudText>
                        @if (!string.IsNullOrEmpty(myProfile.ConsultantName))
                        {
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                <div class="d-flex align-center gap-3">
                                    <MudAvatar Color="Color.Success" Size="Size.Large">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body1" Class="font-weight-bold text-success">@myProfile.ConsultantName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">مشاور تحصیلی شما</MudText>
                                    </div>
                                </div>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CalendarMonth" Href="/StudyPlan">
                                    مشاهده برنامه‌های مشاور
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="rounded-lg">هنوز مشاوری برای شما تعیین نشده است.</MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="rounded-lg">خطا در بارگذاری اطلاعات پرونده.</MudAlert>
}

<style>
    .student-action-card:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease;
    }
</style>

@code {
    private StudentDto? myProfile;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var res = await _http.GetFromJsonAsync<ApiResponse<List<StudentDto>>>("api/students");
            if (res?.Success == true && res.Data?.Count > 0) myProfile = res.Data.First();
        }
        catch (Exception ex) { snackBar.Add($"خطا: {ex.Message}", Severity.Error); }
        finally { isLoading = false; }
    }
}
