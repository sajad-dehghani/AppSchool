@page "/Users"
@using Microsoft.AspNetCore.Authorization
@using NovinApp.Client.Service
@using NovinApp.Client.Component
@using NovinApp.Shared
@inject IJSRuntime JsRuntime
@inject MudBlazor.ISnackbar snackBar
@inject NavigationManager nav
@inject IDialogService Dialog
@inject HttpClient _httpClient
@implements IDisposable
@inject UserProfileStateService UserProfileState
@attribute [Authorize]

<MudPaper Elevation="25" Class="pa-3">
    <MudText Align="Align.Center" Typo="Typo.h5">
        @(IsEdit ? "ویرایش اطلاعات " + Mode + "" : "ثبت " + Mode + " جدید")
    </MudText>
</MudPaper>
<MudDivider DividerType="DividerType.Inset" />

<EditForm Model="@data" OnValidSubmit="Save">
    <MudPaper Elevation="25" Class="p-2 mt-2">
        <DataAnnotationsValidator />
        <MudGrid Class="mt-1 pa-4">

            @* ===== بخش ۱: عکس پروفایل ===== *@
            <MudItem md="12" xs="12">
                <MudCard Elevation="0" Class="d-flex flex-column align-center justify-center pa-4">
                    <MudText Align="Align.Center" Class="rounded-circle mb-4">
                        @if (!string.IsNullOrEmpty(data.pic))
                        {
                            <MudImage Src="@data.pic" Class="rounded-circle" Elevation="5" Height="130" Width="130" />
                        }
                        else
                        {
                            <MudImage Src="img/no_pic.jpg" Class="rounded-circle" Elevation="5" Width="130" Height="130" />
                        }
                    </MudText>

                    <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                        <label for="fileinput" class="label-wrapper">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Size="Size.Small"
                                       HtmlTag="span">
                                بارگذاری عکس
                            </MudButton>
                            <InputFile id="fileinput" accept="image/*" OnChange="OnChange_pic" class="custom-input-hide" />
                        </label>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   OnClick="Del_pic">
                            حذف عکس
                        </MudButton>
                    </MudStack>
                </MudCard>
            </MudItem>

            <MudItem md="12" xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-2" />
            </MudItem>

            @* ===== بخش ۲: اطلاعات هویتی ===== *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="ml-1" />
                    اطلاعات هویتی
                </MudText>
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="نام کاربری"
                              @bind-Value="@data.fname"
                              For="@(() => data.fname)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="نام کاربری الزامی است"
                              MaxLength="100"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="کد ملی"
                              @bind-Value="@data.code_meli"
                              For="@(() => data.code_meli)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="کد ملی الزامی است"
                              MaxLength="20"
                              Mask="@(new RegexMask(@"\d{1,10}"))"
                              AdornmentIcon="@Icons.Material.Filled.CreditCard"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="6" xs="12">
                <MudSelect T="string"
                           Style="text-align:right"
                           Variant="Variant.Outlined"
                           Label="جنسیت"
                           @bind-Value="@data.gender"
                           For="@(() => data.gender)"
                           Margin="Margin.Dense"
                           Required="true"
                           RequiredError="انتخاب جنسیت الزامی است"
                           AdornmentIcon="@Icons.Material.Filled.Wc"
                           Adornment="Adornment.Start">
                    <MudSelectItem Value=@("مرد")>مرد</MudSelectItem>
                    <MudSelectItem Value=@("زن")>زن</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="شماره تماس"
                              @bind-Value="@data.mobile"
                              For="@(() => data.mobile)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="شماره تماس الزامی است"
                              MaxLength="50"
                              Mask="@(new RegexMask(@"\d{1,11}"))"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              Adornment="Adornment.Start" />
            </MudItem>

            <MudItem md="12" xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-2" />
            </MudItem>

            @* ===== بخش ۳: اطلاعات امنیتی و دسترسی ===== *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-3 mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="ml-1" />
                    اطلاعات امنیتی و دسترسی
                </MudText>
            </MudItem>

            <MudItem md="6" xs="12">
                <MudTextField Style="text-align:right"
                              T="string"
                              Variant="Variant.Outlined"
                              Label="رمز عبور"
                              @bind-Value="@data.pass"
                              For="@(() => data.pass)"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="رمز عبور الزامی است"
                              MaxLength="100"
                              InputType="InputType.Password"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Adornment="Adornment.Start" />
            </MudItem>

            @*         @if (UserProfileState.CurrentUser.Rool == "مدیر")
            {
                <MudItem md="6" xs="12">
                    <MudSelect T="string"
                               Style="text-align:right"
                               Variant="Variant.Outlined"
                               Label="نقش کاربری"
                               @bind-Value="@data.Rool"
                               For="@(() => data.Rool)"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="انتخاب نقش الزامی است"
                               AdornmentIcon="@Icons.Material.Filled.AdminPanelSettings"
                               Adornment="Adornment.Start">
                        <MudSelectItem Value=@("دانش آموز")>
                            <MudStack Row="true" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                                <MudText>دانش آموز</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value=@("مشاور")>
                            <MudStack Row="true" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
                                <MudText>مشاور</MudText>
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value=@("مدیر")>
                            <MudStack Row="true" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                                <MudText>مدیر</MudText>
                            </MudStack>
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
            } *@

            @* فیلد وضعیت فعال - تمام عرض *@
            @if (data.Rool == "دانش آموز")
            {
                <MudItem md="6" xs="12" >
                    <MudTextField Disabled Style="text-align:right"
                                  T="string"
                                  Variant="Variant.Outlined"
                                  Label="مشاور انتخابی"
                                  @bind-Value="@data.Moshaver"
                                  For="@(() => data.Moshaver)"
                                  Margin="Margin.Dense"
                                  AdornmentIcon="@Icons.Material.Filled.Person4"
                                  Adornment="Adornment.Start" />

                    <MudAutocomplete Label="جستجو و انتخاب مشاور"
                                     @bind-Value="@selectedMoshaver"
                                     SearchFunc="@SearchUsers"
                                     ToStringFunc="@(u => u?.fname ?? "")"
                                     Variant="Variant.Outlined"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Adornment="Adornment.Start"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     Margin="Margin.Dense"
                                     Immediate="true">

                        <NoItemsTemplate>
                            <MudText Align="Align.Center" Class="px-4 py-1">
                                موردی یافت نشد
                            </MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                </MudItem>
                @*    <MudItem md="6" xs="12">
                    <MudAutocomplete Context="t1" T="User"
                                     Label="جستجو و انتخاب مشاور"
                                     @bind-Value="@selectedMoshaver"
                                     SearchFunc="@SearchUsers"
                                     ToStringFunc="@(u => u?.fname ?? "")"
                                     Variant="Variant.Outlined"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Adornment="Adornment.Start"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     Margin="Margin.Dense"
                                     Immediate="true">
                        <ItemTemplate>
                            <MudStack Row="true" Spacing="2" Class="pa-1">
                                <MudImage Src="@(string.IsNullOrEmpty(t1.pic) ? "img/no_pic.jpg" : t1.pic)"
                                          Class="rounded-circle"
                                          Height="30" Width="30" />
                                <MudText>@t1.fname</MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>
                </MudItem> *@
            }
                <MudSwitch T="bool"
                           @bind-Value="@data.active"
                           Color="Color.Success"
                           Label="کاربر فعال باشد"
                           Class="mt-2" />
            @* ===== بخش ۴: دکمه‌های ثبت و انصراف ===== *@
            <MudItem xs="12">
                <MudDivider DividerType="DividerType.Inset" Class="my-2" />
                <MudCardActions Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Class="ml-2"
                               ButtonType="ButtonType.Submit"
                               Size="Size.Large">
                        @(IsEdit ? "بروزرسانی" : "ثبت")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="GoToBack"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Large">
                        انصراف
                    </MudButton>
                </MudCardActions>
            </MudItem>

        </MudGrid>
    </MudPaper>
</EditForm>

<style>
    .label-wrapper:hover {
        cursor: pointer;
    }

    .custom-input-hide {
        width: 0;
        height: 0;
        overflow: hidden;
    }
</style>

@code {
    public int? Id = 0;
    string Mode = "";
    private bool IsEdit => Id.HasValue && Id.Value > 0;
    private bool isActive = true;
    User data = new User();

    protected override async Task OnInitializedAsync()
    {

        await Loadmoshaver();
        if (Cls_global.IsEdit)
        {
            if (Cls_global.select_row_titr == "Moshaver")
            {
                Mode = "مشاور ";
                data.Rool = "مشاور";
            }

            if (Cls_global.select_row_titr == "Students")
            {
                Mode = " دانش آموز ";
                data.Rool = "دانش آموز";
            }

            Id = Cls_global.select_row_id;
            await LoadUser();
        }
        else
        {
            data = new User { active = true };
            if (Cls_global.select_row_titr == "Moshaver")
            {
                Mode = "مشاور ";
                data.Rool = "مشاور";
            }

            if (Cls_global.select_row_titr == "Students")
            {
                Mode = "دانش آموز ";
                data.Rool = "دانش آموز";
            }

            isActive = true;
        }
    }

    async Task LoadUser()
    {
        try
        {
            data = await _httpClient.GetFromJsonAsync<User>($"api/User/{Id}");

            //selectedMoshaver = await _httpClient.GetFromJsonAsync<User>($"api/User/{data.Id_Moshaver}");
            isActive = data.active;


            if (data == null)
            {
                snackBar.Add("کاربر مورد نظر یافت نشد", Severity.Error);
                nav.NavigateTo("/UsersList");
                return;
            }
        }
        catch
        {
            snackBar.Add("خطا در دریافت اطلاعات کاربر", Severity.Error);
            nav.NavigateTo("/UsersList");
        }
    }

    async Task Save()
    {
        data.active = isActive;

        if (data.Rool == "دانش آموز")
        {
            data.Id_Moshaver = selectedMoshaver.Id;
            data.Moshaver = selectedMoshaver.fname;


        }
        else
        {
            data.Id_Moshaver = 0;
            data.Moshaver = "";

        }
        data.Id_School = UserProfileState.CurrentUser.Id;

        HttpResponseMessage response;

        if (IsEdit)
        {
            response = await _httpClient.PutAsJsonAsync($"api/User", data);
        }
        else
        {
            response = await _httpClient.PostAsJsonAsync("api/User", data);
        }

        if (response.IsSuccessStatusCode)
        {
            snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
            snackBar.Add(IsEdit ? "اطلاعات با موفقیت بروزرسانی شد" : "کاربر با موفقیت ثبت شد", Severity.Success);
            nav.NavigateTo("/UsersList");
        }
        else
        {
            snackBar.Configuration.PositionClass = Defaults.Classes.Position.BottomEnd;
            snackBar.Add("عملیات با خطا مواجه شد. لطفاً مجدد تلاش کنید", Severity.Error);
        }
    }

    public async Task<bool> OpenDialog(string txt)
    {
        var parameters = new DialogParameters();
        parameters.Add("mytext", txt);
        var dialog = await Dialog.ShowAsync<Alert_qoustion>("", parameters);
        var result = await dialog.Result;
        return !result.Canceled;
    }

    ImageFile filesBase64_pic = new ImageFile();

    async Task OnChange_pic(InputFileChangeEventArgs e)
    {
        if (e.File.Size / 1024 > 1024)
        {
            snackBar.Add("سایز عکس بیش از اندازه بزرگ می باشد", Severity.Warning);
            return;
        }
        var file = e.File;
        var buf = new byte[file.Size];
        using (var stream = file.OpenReadStream(int.MaxValue))
        {
            await stream.ReadAsync(buf);
        }
        data.pic = $"data:{file.ContentType};base64,{Convert.ToBase64String(buf)}";
    }

    void Del_pic()
    {
        data.pic = null;
    }

    void GoToBack()
    {

        if (Cls_global.select_row_titr == "Students")
        {
            Cls_global.IsEdit = false;
            Cls_global.select_row_id = -1;
            Cls_global.select_row_titr = "";
            nav.NavigateTo("/Students");

        }
        else
        {
            Cls_global.IsEdit = false;
            Cls_global.select_row_id = -1;
            Cls_global.select_row_titr = "";
            nav.NavigateTo("/Moshaver");

        }
    }

    User? selectedMoshaver;

    private IEnumerable<User> userList = new List<User>();
    async Task Loadmoshaver()
    {
        try
        {
            userList = await _httpClient.GetFromJsonAsync<List<User>>("api/User/moshaver");
        }
        catch
        {
            snackBar.Add("خطا در دریافت لیست کاربران", Severity.Error);
        }
    }
    async Task<IEnumerable<User>> SearchUsers(string searchText, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return userList.Take(10);

        // یه await واقعی بذار که CancellationToken رو چک کنه
        await Task.Delay(10, token);

        return userList
            .Where(x => !string.IsNullOrEmpty(x.fname) &&
                        x.fname.Contains(searchText, StringComparison.InvariantCultureIgnoreCase))
            .Take(10);
    }
    private CancellationTokenSource? _cts;
    public void Dispose()
    {
        // ۱. لغو تمام عملیات Async در حال اجرا
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        Cls_global.IsEdit = false;
        Cls_global.select_row_id = -1;
        Cls_global.select_row_titr = "";
        // ۲. پاک کردن دیتای فرم
        data = null;
        Id = null;
        selectedMoshaver = null;
        userList = null;
        filesBase64_pic = null;

    }
}