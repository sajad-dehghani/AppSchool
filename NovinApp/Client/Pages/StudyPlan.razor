@code {
    private bool isLoading = true;
    private string calendarViewMode = "Month"; // Month, Week, List

    private DateTime currentNavDate = DateTime.Now;
    private int currentPersianYear;
    private int currentPersianMonth;
    private string currentPeriodTitle = "";

    private string selectedDayDate = "";
    private string selectedDayName = "";

    private List<PersianCalendarDayInfo> monthDays = new();
    private List<PersianCalendarDayInfo> weekDays = new();

    private List<StudyPlanItemDto> plans = new();
    private List<StudentDto> studentList = new();
    private int selectedStudentUserId = 0;
    private int pendingRequestsCount = 0;

    private StudyPlannerStatsDto stats = new();

    private string listSearchString = "";
    private string listActivityFilter = "";

    private IEnumerable<StudyPlanItemDto> FilteredDisplayPlans
    {
        get
        {
            var query = plans.AsEnumerable();

            if (calendarViewMode != "List" && !string.IsNullOrEmpty(selectedDayDate))
            {
                query = query.Where(p => p.PersianDate == selectedDayDate);
            }

            if (!string.IsNullOrWhiteSpace(listActivityFilter))
            {
                query = query.Where(p => p.ActivityType == listActivityFilter);
            }

            if (!string.IsNullOrWhiteSpace(listSearchString))
            {
                query = query.Where(p =>
                    (p.Subject?.Contains(listSearchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Topic?.Contains(listSearchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.StudentName?.Contains(listSearchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.ConsultantNote?.Contains(listSearchString, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query.OrderBy(p => p.PersianDate).ThenBy(p => p.StartTime);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (y, m, _) = PersianDateHelper.GetPersianParts(currentNavDate);
        currentPersianYear = y;
        currentPersianMonth = m;

        selectedDayDate = PersianDateHelper.NowPersianDate();
        selectedDayName = PersianDateHelper.GetPersianDayOfWeek(DateTime.Now);

        await LoadStudents();
        await RefreshData();
    }

    private async Task LoadStudents()
    {
        if (!UserProfileState.IsStudent)
        {
            try
            {
                var res = await Http.GetFromJsonAsync<ApiResponse<List<StudentDto>>>("api/students");
                if (res?.Success == true && res.Data != null)
                    studentList = res.Data;
            }
            catch { }
        }
    }

    private async Task RefreshData()
    {
        isLoading = true;
        try
        {
            // محاسبه روزهای تقویم ماهانه و هفتگی
            monthDays = PersianDateHelper.GetMonthCalendarDays(currentPersianYear, currentPersianMonth);
            weekDays = PersianDateHelper.GetWeekDays(currentNavDate);

            var monthName = PersianDateHelper.GetPersianMonthName(currentPersianMonth);
            currentPeriodTitle = $"{monthName} {currentPersianYear}";

            // بازه تاریخی مورد نظر برای دریافت برنامه‌ها
            var startDate = monthDays.First().PersianDate;
            var endDate = monthDays.Last().PersianDate;

            string url = $"api/studyplans?startPersianDate={startDate}&endPersianDate={endDate}";
            if (selectedStudentUserId > 0)
                url += $"&studentUserId={selectedStudentUserId}";

            var res = await Http.GetFromJsonAsync<ApiResponse<List<StudyPlanItemDto>>>(url);
            if (res?.Success == true && res.Data != null)
                plans = res.Data;

            // دریافت آمار
            string statsUrl = $"api/studyplans/stats?startPersianDate={startDate}&endPersianDate={endDate}";
            if (selectedStudentUserId > 0) statsUrl += $"&studentUserId={selectedStudentUserId}";
            var statsRes = await Http.GetFromJsonAsync<ApiResponse<StudyPlannerStatsDto>>(statsUrl);
            if (statsRes?.Success == true && statsRes.Data != null)
                stats = statsRes.Data;

            // دریافت تعداد درخواست‌های مشاوره در انتظار
            if (UserProfileState.IsConsultant || UserProfileState.IsSystemAdmin)
            {
                var reqsRes = await Http.GetFromJsonAsync<ApiResponse<List<CounselingRequestDto>>>("api/studyplans/counseling-requests");
                if (reqsRes?.Success == true && reqsRes.Data != null)
                    pendingRequestsCount = reqsRes.Data.Count(r => r.Status == CounselingStatus.Pending);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری اطلاعات: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnStudentSelectionChanged()
    {
        await RefreshData();
    }

    private void SelectDay(string persianDate)
    {
        selectedDayDate = persianDate;
        if (PersianDateHelper.TryParsePersianDate(persianDate, out var dt))
            selectedDayName = PersianDateHelper.GetPersianDayOfWeek(dt);
    }

    private async Task GoPreviousPeriod()
    {
        if (calendarViewMode == "Week")
        {
            currentNavDate = currentNavDate.AddDays(-7);
            var (y, m, _) = PersianDateHelper.GetPersianParts(currentNavDate);
            currentPersianYear = y;
            currentPersianMonth = m;
        }
        else
        {
            currentPersianMonth--;
            if (currentPersianMonth < 1)
            {
                currentPersianMonth = 12;
                currentPersianYear--;
            }
            currentNavDate = PersianDateHelper.PersianToGregorian(currentPersianYear, currentPersianMonth, 1);
        }
        await RefreshData();
    }

    private async Task GoNextPeriod()
    {
        if (calendarViewMode == "Week")
        {
            currentNavDate = currentNavDate.AddDays(7);
            var (y, m, _) = PersianDateHelper.GetPersianParts(currentNavDate);
            currentPersianYear = y;
            currentPersianMonth = m;
        }
        else
        {
            currentPersianMonth++;
            if (currentPersianMonth > 12)
            {
                currentPersianMonth = 1;
                currentPersianYear++;
            }
            currentNavDate = PersianDateHelper.PersianToGregorian(currentPersianYear, currentPersianMonth, 1);
        }
        await RefreshData();
    }

    private async Task GoToToday()
    {
        currentNavDate = DateTime.Now;
        var (y, m, _) = PersianDateHelper.GetPersianParts(currentNavDate);
        currentPersianYear = y;
        currentPersianMonth = m;
        selectedDayDate = PersianDateHelper.NowPersianDate();
        selectedDayName = PersianDateHelper.GetPersianDayOfWeek(DateTime.Now);
        await RefreshData();
    }

    private Color GetActivityChipColor(string activityType) => activityType switch
    {
        ActivityTypes.Test => Color.Primary,
        ActivityTypes.Study => Color.Success,
        ActivityTypes.Video => Color.Info,
        ActivityTypes.Class => Color.Warning,
        ActivityTypes.DescriptiveQuestions => Color.Tertiary,
        ActivityTypes.InPersonCounseling => Color.Secondary,
        ActivityTypes.OnlineCounseling => Color.Dark,
        ActivityTypes.Exam => Color.Error,
        _ => Color.Default
    };

    private string GetActivityColor(string activityType) => activityType switch
    {
        ActivityTypes.Test => "pill-blue",
        ActivityTypes.Study => "pill-green",
        ActivityTypes.Video => "pill-cyan",
        ActivityTypes.Class => "pill-orange",
        ActivityTypes.DescriptiveQuestions => "pill-teal",
        ActivityTypes.InPersonCounseling => "pill-purple",
        ActivityTypes.OnlineCounseling => "pill-purple",
        ActivityTypes.Exam => "pill-orange",
        _ => "pill-grey"
    };

    // دیالوگ‌های مختلف
    private async Task OpenCreatePlanDialog()
    {
        var parameters = new DialogParameters
        {
            { "PreselectedStudentUserId", selectedStudentUserId > 0 ? selectedStudentUserId : (int?)null },
            { "PreselectedPersianDate", selectedDayDate }
        };
        var dialog = await DialogService.ShowAsync<PlanCreateEditDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenCreatePlanForDate(string persianDate)
    {
        var parameters = new DialogParameters
        {
            { "PreselectedStudentUserId", selectedStudentUserId > 0 ? selectedStudentUserId : (int?)null },
            { "PreselectedPersianDate", persianDate }
        };
        var dialog = await DialogService.ShowAsync<PlanCreateEditDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenEditPlanDialog(StudyPlanItemDto plan)
    {
        var dto = new StudyPlanCreateUpdateDto
        {
            Id = plan.Id,
            StudentUserId = plan.StudentUserId,
            StudentName = plan.StudentName,
            PersianDate = plan.PersianDate,
            StartTime = plan.StartTime,
            DurationMinutes = plan.DurationMinutes,
            ActivityType = plan.ActivityType,
            TestCount = plan.TestCount,
            TestType = plan.TestType,
            GradeLevel = plan.GradeLevel,
            FieldOfStudy = plan.FieldOfStudy,
            Subject = plan.Subject,
            Chapter = plan.Chapter,
            Topic = plan.Topic,
            ConsultantNote = plan.ConsultantNote,
            ConsultantAttachmentUrl = plan.ConsultantAttachmentUrl,
            ConsultantAttachmentName = plan.ConsultantAttachmentName,
            IsCounselingSession = plan.IsCounselingSession,
            CounselingType = plan.CounselingType,
            MeetingLink = plan.MeetingLink
        };

        var parameters = new DialogParameters { { "Model", dto } };
        var dialog = await DialogService.ShowAsync<PlanCreateEditDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenCreateCounselingDialog()
    {
        var dto = new StudyPlanCreateUpdateDto
        {
            ActivityType = ActivityTypes.OnlineCounseling,
            IsCounselingSession = true,
            Subject = "جلسه مشاوره و راهنمایی تحصیلی",
            PersianDate = selectedDayDate,
            DurationMinutes = 45,
            StudentUserId = selectedStudentUserId > 0 ? selectedStudentUserId : 0
        };
        var parameters = new DialogParameters { { "Model", dto } };
        var dialog = await DialogService.ShowAsync<PlanCreateEditDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenStudentFeedbackDialog(StudyPlanItemDto plan)
    {
        var parameters = new DialogParameters { { "Plan", plan } };
        var dialog = await DialogService.ShowAsync<StudentFeedbackDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenPlanDetails(StudyPlanItemDto plan)
    {
        if (UserProfileState.IsStudent)
            await OpenStudentFeedbackDialog(plan);
        else
            await OpenEditPlanDialog(plan);
    }

    private async Task OpenStudentRequestDialog()
    {
        var parameters = new DialogParameters
        {
            { "IsConsultantView", false },
            { "Model", new CounselingRequestDto { RequestType = "مشاوره آنلاین", PreferredDate = selectedDayDate } }
        };
        var dialog = await DialogService.ShowAsync<CounselingRequestDialog>("", parameters);
        var res = await dialog.Result;
        if (!res.Canceled) await RefreshData();
    }

    private async Task OpenRequestsDialog()
    {
        try
        {
            var reqsRes = await Http.GetFromJsonAsync<ApiResponse<List<CounselingRequestDto>>>("api/studyplans/counseling-requests");
            if (reqsRes?.Success == true && reqsRes.Data?.Count > 0)
            {
                var firstPending = reqsRes.Data.FirstOrDefault(r => r.Status == CounselingStatus.Pending) ?? reqsRes.Data.First();
                var parameters = new DialogParameters
                {
                    { "IsConsultantView", true },
                    { "Model", firstPending }
                };
                var dialog = await DialogService.ShowAsync<CounselingRequestDialog>("", parameters);
                var res = await dialog.Result;
                if (!res.Canceled) await RefreshData();
            }
            else
            {
                Snackbar.Add("درخواست مشاوره جدیدی وجود ندارد.", Severity.Info);
            }
        }
        catch { }
    }

    private async Task OpenTopicBankDialog()
    {
        await DialogService.ShowAsync<TopicBankDialog>("");
    }

    private async Task DeletePlan(int planId)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "حذف برنامه",
            "آیا از حذف این برنامه از تقویم اطمینان دارید؟",
            yesText: "بله، حذف شود", cancelText: "انصراف");

        if (confirm == true)
        {
            var res = await Http.DeleteAsync($"api/studyplans/{planId}");
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("برنامه با موفقیت حذف شد.", Severity.Info);
                await RefreshData();
            }
        }
    }
}
