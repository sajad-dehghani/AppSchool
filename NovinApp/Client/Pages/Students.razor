    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">ویرایش پرونده دانش‌آموز</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@updateModel" OnValidSubmit="SaveUpdateStudent">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2" Class="pt-2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="updateModel.FullName" Label="نام و نام خانوادگی" Variant="Variant.Outlined"
                                  Required="true" For="@(() => updateModel.FullName)" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="updateModel.FatherName" Label="نام پدر" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="updateModel.PhoneNumber" Label="تلفن همراه" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="updateModel.StudentCode" Label="شماره دانش‌آموزی" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="updateModel.GradeLevel" Label="پایه تحصیلی" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("پایه دهم")">پایه دهم</MudSelectItem>
                        <MudSelectItem Value="@("پایه یازدهم")">پایه یازدهم</MudSelectItem>
                        <MudSelectItem Value="@("پایه دوازدهم")">پایه دوازدهم</MudSelectItem>
                        <MudSelectItem Value="@("فارغ‌التحصیل")">فارغ‌التحصیل</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="updateModel.FieldOfStudy" Label="رشته تحصیلی" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("علوم تجربی")">علوم تجربی</MudSelectItem>
                        <MudSelectItem Value="@("ریاضی و فیزیک")">ریاضی و فیزیک</MudSelectItem>
                        <MudSelectItem Value="@("علوم انسانی")">علوم انسانی</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (UserProfileState.IsSystemAdmin)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="updateModel.SchoolId" Label="مدرسه" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var s in schools)
                            {
                                <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="updateModel.ConsultantId" Label="مشاور تحصیلی (اختیاری)" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem Value="@((int?)null)">بدون مشاور</MudSelectItem>
                        @foreach (var c in consultants)
                        {
                            <MudSelectItem Value="@((int?)c.UserId)">@c.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="updateModel.NewPassword" Label="کلمه عبور جدید (اختیاری)" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="updateModel.IsActive" Label="وضعیت فعالیت" Color="Color.Success" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isEditDialogOpen = false)" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdateStudent" Disabled="isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>در حال به‌روزرسانی...</span>
            }
            else
            {
                <span>ذخیره تغییرات</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* دیالوگ اختصاصی انتساب مدرسه و مشاور *@
<MudDialog @bind-Visible="isAssignDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">انتساب مدرسه و مشاور برای @assignStudentName</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3" Class="pt-2">
            @if (UserProfileState.IsSystemAdmin)
            {
                <MudItem xs="12">
                    <MudSelect T="int?" @bind-Value="assignModel.SchoolId" Label="انتخاب مدرسه" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var s in schools)
                        {
                            <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12">
                <MudSelect T="int?" @bind-Value="assignModel.ConsultantId" Label="انتخاب مشاور تحصیلی (اختیاری)" Variant="Variant.Outlined" Clearable="true">
                    <MudSelectItem Value="@((int?)null)">بدون مشاور</MudSelectItem>
                    @foreach (var c in consultants)
                    {
                        <MudSelectItem Value="@((int?)c.UserId)">@c.FullName (@(c.Specialty ?? "مشاور"))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isAssignDialogOpen = false)" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveAssignStudent" Disabled="isSaving">
            ثبت انتساب
        </MudButton>
    </DialogActions>
</MudDialog>

@* دیالوگ انتساب دسته‌جمعی مدرسه و مشاور *@
<MudDialog @bind-Visible="isBulkAssignDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Class="ml-2 align-middle text-success" />
            انتساب دسته‌جمعی (@selectedStudents.Count دانش‌آموز)
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 text-muted">
            گزینه‌های مورد نظر جهت اعمال همزمان روی تمام دانش‌آموزان انتخاب‌شده را مشخص فرمایید:
        </MudText>

        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
            @if (UserProfileState.IsSystemAdmin)
            {
                <div class="mb-3">
                    <MudCheckBox T="bool" @bind-Value="bulkUpdateSchool" Label="تغییر / انتساب مدرسه" Color="Color.Primary" />
                    @if (bulkUpdateSchool)
                    {
                        <MudSelect T="int?" @bind-Value="bulkSelectedSchoolId" Label="انتخاب مدرسه مقصد" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Clearable="true">
                            <MudSelectItem Value="@((int?)null)">بدون مدرسه (حذف مدرسه)</MudSelectItem>
                            @foreach (var s in schools)
                            {
                                <MudSelectItem Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
            }

            <div>
                <MudCheckBox T="bool" @bind-Value="bulkUpdateConsultant" Label="تغییر / انتساب مشاور تحصیلی" Color="Color.Success" />
                @if (bulkUpdateConsultant)
                {
                    <MudSelect T="int?" @bind-Value="bulkSelectedConsultantId" Label="انتخاب مشاور مقصد" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Clearable="true">
                        <MudSelectItem Value="@((int?)null)">بدون مشاور (حذف مشاور فعلی)</MudSelectItem>
                        @foreach (var c in consultants)
                        {
                            <MudSelectItem Value="@((int?)c.UserId)">@c.FullName (@(c.Specialty ?? "مشاور"))</MudSelectItem>
                        }
                    </MudSelect>
                }
            </div>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isBulkAssignDialogOpen = false)" Variant="Variant.Text">انصراف</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveBulkAssign" Disabled="isSaving || (!bulkUpdateSchool && !bulkUpdateConsultant)">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>در حال اعمال انتساب...</span>
            }
            else
            {
                <span>اعمال انتساب دسته‌جمعی</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .page-banner { border-radius: 16px; padding: 20px 24px; }
    .banner-primary { background: linear-gradient(135deg, #0D47A1 0%, #1976D2 60%, #42A5F5 100%); }
</style>

@code {
    private List<StudentDto> students = new();
    private List<SchoolDto> schools = new();
    private List<ConsultantDto> consultants = new();
    private HashSet<StudentDto> selectedStudents = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isCreateDialogOpen = false;
    private bool isEditDialogOpen = false;
    private bool isAssignDialogOpen = false;
    private bool isBulkAssignDialogOpen = false;

    private bool bulkUpdateSchool = false;
    private int? bulkSelectedSchoolId = null;
    private bool bulkUpdateConsultant = false;
    private int? bulkSelectedConsultantId = null;

    private string searchString = "";
    private int? selectedSchoolFilter = null;
    private int? selectedConsultantFilter = null;
    private string assignStudentName = "";

    private CreateStudentDto createModel = new();
    private UpdateStudentDto updateModel = new();
    private AssignStudentDto assignModel = new();

    private DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    private IEnumerable<StudentDto> FilteredStudents =>
        string.IsNullOrWhiteSpace(searchString)
            ? students
            : students.Where(s => (s.FullName != null && s.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
                                  (s.NationalCode != null && s.NationalCode.Contains(searchString)) ||
                                  (s.StudentCode?.ToString().Contains(searchString) ?? false) ||
                                  (s.SchoolName != null && s.SchoolName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
                                  (s.ConsultantName != null && s.ConsultantName.Contains(searchString, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadSchoolsAndConsultants();
        await LoadStudents();
    }

    private async Task LoadSchoolsAndConsultants()
    {
        try
        {
            var schoolMsg = await _http.GetAsync("api/schools");
            var schoolRes = await schoolMsg.ParseApiResponseAsync<List<SchoolDto>>();
            if (schoolRes.Success && schoolRes.Data != null)
                schools = schoolRes.Data;

            var consMsg = await _http.GetAsync("api/consultants");
            var consRes = await consMsg.ParseApiResponseAsync<List<ConsultantDto>>();
            if (consRes.Success && consRes.Data != null)
                consultants = consRes.Data;
        }
        catch { }
    }

    private async Task LoadStudents()
    {
        isLoading = true;
        try
        {
            string url = "api/students?";
            if (selectedSchoolFilter.HasValue) url += $"schoolId={selectedSchoolFilter.Value}&";
            if (selectedConsultantFilter.HasValue) url += $"consultantId={selectedConsultantFilter.Value}&";

            var response = await _http.GetAsync(url);
            var res = await response.ParseApiResponseAsync<List<StudentDto>>();
            if (res.Success && res.Data != null)
            {
                students = res.Data;
            }
            else
            {
                students = new();
                if (!string.IsNullOrEmpty(res.Message))
                {
                    snackBar.Add(res.Message, Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا در بارگذاری دانش‌آموزان: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        createModel = new CreateStudentDto
        {
            GradeLevel = "پایه دوازدهم",
            FieldOfStudy = "علوم تجربی",
            Gender = "مرد"
        };
        isCreateDialogOpen = true;
    }

    private void OpenEditDialog(StudentDto student)
    {
        updateModel = new UpdateStudentDto
        {
            Id = student.Id,
            FullName = student.FullName,
            FatherName = student.FatherName,
            PhoneNumber = student.PhoneNumber,
            StudentCode = student.StudentCode,
            GradeLevel = student.GradeLevel,
            FieldOfStudy = student.FieldOfStudy,
            SchoolId = student.SchoolId,
            ConsultantId = student.ConsultantId,
            IsActive = student.IsActive
        };
        isEditDialogOpen = true;
    }

    private void OpenAssignDialog(StudentDto student)
    {
        assignStudentName = student.FullName;
        assignModel = new AssignStudentDto
        {
            StudentId = student.Id,
            SchoolId = student.SchoolId,
            ConsultantId = student.ConsultantId
        };
        isAssignDialogOpen = true;
    }

    private async Task SaveCreateStudent()
    {
        if (string.IsNullOrWhiteSpace(createModel.FullName) || string.IsNullOrWhiteSpace(createModel.NationalCode) || string.IsNullOrWhiteSpace(createModel.Password))
        {
            snackBar.Add("نام، کد ملی و کلمه عبور الزامی است.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            var res = await _http.PostAsJsonAsync("api/students", createModel);
            var apiRes = await res.ParseApiResponseAsync<StudentDto>();
            if (apiRes.Success)
            {
                snackBar.Add("دانش‌آموز جدید با موفقیت ثبت شد.", Severity.Success);
                isCreateDialogOpen = false;
                await LoadStudents();
            }
            else
            {
                snackBar.Add(apiRes.Message ?? "خطا در ثبت دانش‌آموز", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطای سیستمی: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveUpdateStudent()
    {
        if (string.IsNullOrWhiteSpace(updateModel.FullName))
        {
            snackBar.Add("نام دانش‌آموز الزامی است.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            var res = await _http.PutAsJsonAsync($"api/students/{updateModel.Id}", updateModel);
            var apiRes = await res.ParseApiResponseAsync<bool>();
            if (apiRes.Success)
            {
                snackBar.Add("اطلاعات دانش‌آموز به‌روزرسانی شد.", Severity.Success);
                isEditDialogOpen = false;
                await LoadStudents();
            }
            else
            {
                snackBar.Add(apiRes.Message ?? "خطا در به‌روزرسانی", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطای سیستمی: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAssignStudent()
    {
        isSaving = true;
        try
        {
            var res = await _http.PutAsJsonAsync($"api/students/{assignModel.StudentId}/assign", assignModel);
            var apiRes = await res.ParseApiResponseAsync<bool>();
            if (apiRes.Success)
            {
                snackBar.Add("انتساب با موفقیت انجام شد.", Severity.Success);
                isAssignDialogOpen = false;
                await LoadStudents();
            }
            else
            {
                snackBar.Add(apiRes.Message ?? "خطا در انتساب", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteStudent(StudentDto student)
    {
        var parameters = new DialogParameters();
        parameters.Add("mytext", $"آیا از حذف دانش‌آموز «{student.FullName}» و تمام سوابق مربوطه اطمینان دارید؟");
        var dialog = await dialogService.ShowAsync<Alert_qoustion>("", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                var res = await _http.DeleteAsync($"api/students/{student.Id}");
                var apiRes = await res.ParseApiResponseAsync<bool>();
                if (apiRes.Success)
                {
                    snackBar.Add("دانش‌آموز با موفقیت حذف شد.", Severity.Success);
                    await LoadStudents();
                }
                else
                {
                    snackBar.Add(apiRes.Message ?? "خطا در حذف", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                snackBar.Add($"خطا: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task RefreshStudents()
    {
        await LoadSchoolsAndConsultants();
        await LoadStudents();
        snackBar.Add("لیست دانش‌آموزان به‌روزرسانی شد.", Severity.Info);
    }

    private void OpenBulkAssignDialog()
    {
        if (selectedStudents == null || !selectedStudents.Any())
        {
            snackBar.Add("لطفاً حداقل یک دانش‌آموز را انتخاب فرمایید.", Severity.Warning);
            return;
        }

        bulkUpdateSchool = false;
        bulkSelectedSchoolId = null;
        bulkUpdateConsultant = true;
        bulkSelectedConsultantId = null;
        isBulkAssignDialogOpen = true;
    }

    private async Task SaveBulkAssign()
    {
        if (selectedStudents == null || !selectedStudents.Any()) return;
        if (!bulkUpdateSchool && !bulkUpdateConsultant)
        {
            snackBar.Add("حداقل یکی از گزینه‌های تغییر مدرسه یا تغییر مشاور را انتخاب نمایید.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            var req = new BulkAssignStudentsDto
            {
                StudentIds = selectedStudents.Select(s => s.Id).ToList(),
                UpdateSchool = bulkUpdateSchool,
                SchoolId = bulkSelectedSchoolId,
                UpdateConsultant = bulkUpdateConsultant,
                ConsultantId = bulkSelectedConsultantId
            };

            var res = await _http.PostAsJsonAsync("api/students/bulk-assign", req);
            var apiRes = await res.ParseApiResponseAsync<bool>();
            if (apiRes.Success)
            {
                snackBar.Add(apiRes.Message ?? "انتساب دسته‌جمعی با موفقیت انجام شد.", Severity.Success);
                isBulkAssignDialogOpen = false;
                selectedStudents.Clear();
                await LoadStudents();
            }
            else
            {
                snackBar.Add(apiRes.Message ?? "خطا در انتساب دسته‌جمعی", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task BulkDeleteStudents()
    {
        if (selectedStudents == null || !selectedStudents.Any())
        {
            snackBar.Add("هیچ دانش‌آموزی انتخاب نشده است.", Severity.Warning);
            return;
        }

        var count = selectedStudents.Count;
        var parameters = new DialogParameters();
        parameters.Add("mytext", $"آیا از حذف دسته‌جمعی {count} دانش‌آموز انتخاب‌شده و کلیه سوابق مربوطه اطمینان دارید؟");
        var dialog = await dialogService.ShowAsync<Alert_qoustion>("", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isSaving = true;
            try
            {
                var req = new BulkDeleteStudentsDto
                {
                    StudentIds = selectedStudents.Select(s => s.Id).ToList()
                };

                var res = await _http.PostAsJsonAsync("api/students/bulk-delete", req);
                var apiRes = await res.ParseApiResponseAsync<bool>();
                if (apiRes.Success)
                {
                    snackBar.Add(apiRes.Message ?? $"{count} دانش‌آموز با موفقیت حذف شدند.", Severity.Success);
                    selectedStudents.Clear();
                    await LoadStudents();
                }
                else
                {
                    snackBar.Add(apiRes.Message ?? "خطا در حذف دسته‌جمعی", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                snackBar.Add($"خطا: {ex.Message}", Severity.Error);
            }
            finally
            {
                isSaving = false;
            }
        }
    }
}
