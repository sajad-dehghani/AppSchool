    private static List<QuestionAnswerItem> ParseAnswerSheet(string? keySheet, string? answerSheet, int maxQuestions = 300)
    {
        var list = new List<QuestionAnswerItem>();
        if (string.IsNullOrWhiteSpace(keySheet) && string.IsNullOrWhiteSpace(answerSheet)) return list;

        string keys = (keySheet ?? "").Trim();
        string answers = (answerSheet ?? "").Trim();
        int rawCount = Math.Max(keys.Length, answers.Length);
        if (rawCount == 0) return list;

        // سقف حداکثر ۳۰۰ سوال به صورت پیش‌فرض (یا مقدار انتخابی کاربر)
        int count = maxQuestions > 0 ? Math.Min(rawCount, maxQuestions) : rawCount;

        for (int i = 0; i < count; i++)
        {
            char kChar = (i < keys.Length) ? keys[i] : '0';
            int keyVal = int.TryParse(kChar.ToString(), out int kv) ? kv : 0;

            char aChar = (i < answers.Length) ? answers[i] : '0';
            int ansVal = int.TryParse(aChar.ToString(), out int av) ? av : 0;

            list.Add(new QuestionAnswerItem
            {
                QuestionNumber = i + 1,
                CorrectKey = keyVal,
                StudentChoice = ansVal
            });
        }

        return list;
    }

