@page "/StudentReports"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NovinApp.Client.Service
@using NovinApp.Shared
@inject HttpClient _httpClient
@inject UserProfileStateService UserProfileState
@inject ISnackbar snackBar
@inject IJSRuntime JS
@inject NavigationManager nav
@attribute [Authorize]

<div class="student-reports-page">
    @* نوار جستجو و ابزار بالا *@
    <MudPaper Elevation="3" Class="pa-4 mb-4 no-print" Style="border-radius: 14px; background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%); color: white;">
        <div class="d-flex justify-space-between align-center flex-wrap gap-3">
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="ml-2 align-middle" />
                    سامانه کارنامه‌های تحلیلی نتایج آزمون‌های آزمایشی
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-1" Style="opacity: 0.9;">
                    مشاهده کارنامه عددی، نمودار وضعیت دروس، روند پیشرفت تراز، پاسخ‌برگ چهارگزینه‌ای و تحلیل نقاط قوت و ضعف
                </MudText>
            </div>

            @* جستجوی سریع کد ملی *@
            <div class="d-flex align-center gap-2" style="min-width: 320px;">
                <MudTextField @bind-Value="searchNationalCode" Placeholder="کد ملی داوطلب..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Surface"
                              Class="bg-white rounded-lg text-dark"
                              OnKeyDown="@HandleSearchKeyDown" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => SearchReports(searchNationalCode)" Class="rounded-lg font-weight-bold px-4">
                    جستجو
                </MudButton>
            </div>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-center align-center my-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.subtitle1" Class="ms-3">در حال فراخوانی کارنامه‌های آزمون دانش‌آموز...</MudText>
        </div>
    }
    else if (!reportsList.Any())
    {
        <MudCard Elevation="2" Class="pa-6 my-6 rounded-xl text-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">کارنامه‌ای برای کد ملی «@(targetNationalCode ?? "نامشخص")» یافت نشد</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                لطفاً کد ملی را بررسی نموده یا از جدول بارگذاری فایل اکسل اقدام به ثبت نتایج نمایید.
            </MudText>
        </MudCard>
    }
    else
    {
        @* نوار مشخصات کلی داوطلب *@
        <MudCard Elevation="3" Class="pa-4 mb-4 rounded-xl no-print">
            <div class="d-flex align-center flex-wrap gap-4">
                <div class="student-avatar-box">
                    @if (!string.IsNullOrEmpty(UserProfileState.CurrentUser?.pic))
                    {
                        <img src="@UserProfileState.CurrentUser.pic" class="avatar-img-circle" alt="عکس دانش‌آموز" />
                    }
                    else
                    {
                        <div class="avatar-placeholder-circle">
                            @(GetStudentName().Length > 0 ? GetStudentName()[0].ToString() : "د")
                        </div>
                    }
                </div>

                <div class="flex-grow-1">
                    <div class="d-flex align-center gap-2 flex-wrap mb-1">
                        <MudText Typo="Typo.h5" Class="font-weight-bold text-primary">@GetStudentName()</MudText>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                            کد ملی: @targetNationalCode
                        </MudChip>
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                            @(firstReport?.Student_LevelNameString ?? "متوسطه") - @(firstReport?.Student_Section_Name ?? "رشته تحصیلی")
                        </MudChip>
                    </div>
                    <div class="d-flex gap-4 flex-wrap text-muted small mt-2">
                        <span><strong>مدرسه:</strong> @(firstReport?.Student_School_Name ?? "---")</span>
                        <span><strong>منطقه:</strong> @(firstReport?.Student_Region_Name ?? "---")</span>
                        <span><strong>نام پدر:</strong> @(firstReport?.Student_FatherName ?? "---")</span>
                    </div>
                </div>

                @* شاخص‌های کلیدی تراز کل *@
                <div class="d-flex gap-2 flex-wrap">
                    <div class="stat-pill bg-light-blue">
                        <span class="stat-pill-title">تعداد مراحل آزمون</span>
                        <span class="stat-pill-val">@reportsList.Count</span>
                    </div>
                    <div class="stat-pill bg-light-green">
                        <span class="stat-pill-title">بالاترین تراز ثبت‌شده</span>
                        <span class="stat-pill-val text-success">@MaxTaraz.ToString("F1")</span>
                    </div>
                    <div class="stat-pill bg-light-purple">
                        <span class="stat-pill-title">میانگین تراز کل مراحل</span>
                        <span class="stat-pill-val text-primary">@AvgTaraz.ToString("F1")</span>
                    </div>
                </div>
            </div>
        </MudCard>

        @* انتخاب مرحله آزمون *@
        <div class="d-flex align-center gap-2 mb-3 flex-wrap no-print">
            <span class="font-weight-bold text-dark ml-2">مرحله آزمون:</span>
            @foreach (var rep in reportsList)
            {
                bool isSelected = selectedReport?.ID == rep.ID;
                <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                           Color="@(isSelected ? Color.Primary : Color.Default)"
                           Size="Size.Medium"
                           Class="rounded-lg font-weight-bold"
                           OnClick="() => SelectReport(rep)">
                    @(string.IsNullOrWhiteSpace(rep.ExamName) ? "مرحله " + rep.ID : rep.ExamName)
                    <span class="small opacity-75 mr-2">(@rep.Total_Taraz.ToString("F0"))</span>
                </MudButton>
            }
        </div>

        @if (selectedReport != null)
        {
            @* ==========================================
               تب‌های ناوبری ۵ گانه مشابه schoolfars.ir
               ۱. Result (نتیجه کارنامه)
               ۲. StatusCharts (نمودارهای وضعیت دروس)
               ۳. ProgressChart (روند پیشرفت تراز)
               ۴. AnswerSheet (پاسخ‌برگ چهارگزینه‌ای)
               ۵. StWe (نقاط قوت و ضعف)
               ========================================== *@
            <MudPaper Elevation="2" Class="mb-4 rounded-xl no-print overflow-hidden">
                <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                         Color="Color.Primary" @bind-ActivePanelIndex="activeTab"
                         PanelClass="pa-0">
                    <MudTabPanel Text="نتیجه آزمون (Result)" Icon="@Icons.Material.Filled.TableChart" />
                    <MudTabPanel Text="نمودارهای وضعیت دروس (StatusCharts)" Icon="@Icons.Material.Filled.BarChart" />
                    <MudTabPanel Text="روند پیشرفت تراز (ProgressChart)" Icon="@Icons.Material.Filled.ShowChart" />
                    <MudTabPanel Text="پاسخ‌برگ چهارگزینه‌ای (AnswerSheet)" Icon="@Icons.Material.Filled.Ballot" />
                    <MudTabPanel Text="نقاط قوت و ضعف (StWe)" Icon="@Icons.Material.Filled.Insights" />
                    <MudTabPanel Text="نمای کامل چاپی (PDF Report)" Icon="@Icons.Material.Filled.Print" />
                </MudTabs>
            </MudPaper>

            <div class="detailed-report-container" id="printableStudentReport">
                @* سربرگ اصلی کارنامه *@
                <div class="report-header-banner">
                    <div class="report-header-top">
                        <div class="header-logo-section">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Class="header-icon" />
                            <div>
                                <h1 class="header-main-title">کارنامه تحلیلی نتایج آزمون</h1>
                                <span class="header-sub-title">سامانه هوشمند سنجش، آزمون و هدایت تحصیلی نوین</span>
                            </div>
                        </div>
                        <div class="header-exam-meta">
                            <span class="exam-name-pill">@(string.IsNullOrWhiteSpace(selectedReport.ExamName) ? "آزمون مرحله " + selectedReport.ID : selectedReport.ExamName)</span>
                            <span class="exam-date-text">تاریخ برگزاری: @FormatDate(selectedReport.UploadTime)</span>
                        </div>
                    </div>

                    @* نوار مشخصات داوطلب *@
                    <div class="report-student-profile-strip">
                        <div class="student-photo-col">
                            @if (!string.IsNullOrEmpty(UserProfileState.CurrentUser?.pic))
                            {
                                <img src="@UserProfileState.CurrentUser.pic" class="student-print-photo" alt="عکس دانش‌آموز" />
                            }
                            else
                            {
                                <div class="student-photo-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                                </div>
                            }
                        </div>

                        <div class="student-details-grid">
                            <div class="meta-item">
                                <span class="meta-label">نام و نام خانوادگی:</span>
                                <span class="meta-value font-weight-bold">@(selectedReport.Student_FullName ?? GetStudentName())</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">کد ملی:</span>
                                <span class="meta-value">@selectedReport.Student_NationalCode</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">نام پدر:</span>
                                <span class="meta-value">@(selectedReport.Student_FatherName ?? "---")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">مدرسه:</span>
                                <span class="meta-value">@(selectedReport.Student_School_Name ?? "---")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">پایه تحصیلی:</span>
                                <span class="meta-value">@(selectedReport.Student_LevelNameString ?? "---")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">رشته / گروه:</span>
                                <span class="meta-value">@(selectedReport.Student_Section_Name ?? "---")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">منطقه آموزشی:</span>
                                <span class="meta-value">@(selectedReport.Student_Region_Name ?? "---")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">شماره داوطلب:</span>
                                <span class="meta-value">@(selectedReport.StudentCode > 0 ? selectedReport.StudentCode.ToString() : selectedReport.ID.ToString())</span>
                            </div>
                        </div>
                    </div>

                    @* شاخص‌های کلان آزمون *@
                    <div class="overall-scores-strip">
                        <div class="overall-score-cell taraz-cell">
                            <span class="cell-label">تراز کل آزمون</span>
                            <span class="cell-number">@selectedReport.Total_Taraz.ToString("F1")</span>
                            <span class="cell-sub">بالاترین تراز: @selectedReport.Total_MaxTararz.ToString("F1")</span>
                        </div>
                        <div class="overall-score-cell percent-cell">
                            <span class="cell-label">میانگین درصد کل</span>
                            <span class="cell-number">@selectedReport.Total_Percent.ToString("F1")%</span>
                            <span class="cell-sub">میانگین آزمون: @selectedReport.Total_PercentAvarage.ToString("F1")%</span>
                        </div>
                        <div class="overall-score-cell rank-cell">
                            <span class="cell-label">رتبه در کشور</span>
                            <span class="cell-number">@selectedReport.Total_RankTotal</span>
                            <span class="cell-sub">حاضرین: @selectedReport.ExamStatictics_PresentCount</span>
                        </div>
                        <div class="overall-score-cell rank-cell">
                            <span class="cell-label">رتبه مدرسه / منطقه</span>
                            <span class="cell-number">@selectedReport.Total_RankSchool / @selectedReport.Total_RankArea</span>
                            <span class="cell-sub">منطقه: @selectedReport.Student_Region_Name</span>
                        </div>
                        <div class="overall-score-cell answers-cell">
                            <span class="cell-label">ترکیب پاسخ‌ها</span>
                            <div class="answers-count-row">
                                <span class="ans-badge correct">صحیح: @selectedReport.Total_True</span>
                                <span class="ans-badge wrong">غلط: @selectedReport.Total_False</span>
                                <span class="ans-badge blank">نزده: @selectedReport.Total_Blank</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* نوار گرادیان وضعیت کل داوطلب (Status Gradient Bar مشابه schoolfars.ir) *@
                <div class="status-gradient-card mt-4">
                    <div class="d-flex justify-space-between align-center mb-1">
                        <span class="font-weight-bold text-dark" style="font-size: 13px;">طیف سنجش وضعیت علمی داوطلب:</span>
                        <span class="badge-status-title @GetTotalStatusClass()">وضعیت کل: @GetTotalStatusTitle()</span>
                    </div>

                    <div id="schoolfarsBar">
                        <div class="statusZone">بسیار ضعیف</div>
                        <div class="statusZone">ضعیف</div>
                        <div class="statusZone">متوسط</div>
                        <div class="statusZone">خوب</div>
                        <div class="statusZone">خیلی خوب</div>
                        <div class="statusZone">عالی</div>
                    </div>

                    @* نشانگر متحرک موقعیت داوطلب روی نوار *@
                    <div class="marker-track">
                        <div class="status-marker-pointer" style="right: @CalcStatusMarkerRight()%;">
                            <div class="marker-arrow-down">▼</div>
                            <span class="marker-taraz-badge">@selectedReport.Total_Taraz.ToString("F0")</span>
                        </div>
                    </div>
                </div>

                @* ==========================================
                   محتوای تب‌ها
                   ========================================== *@
                @if (activeTab == 0 || activeTab == 5)
                {
                    @* تب ۱: جدول عددی دروس (Result) *@
                    <div class="report-section-card mt-4">
                        <div class="section-card-header d-flex justify-space-between align-center">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="ml-2 text-primary" />
                                <h2 class="section-card-title">جدول عددی عملکرد داوطلب به تفکیک دروس آزمون</h2>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReport" Class="no-print font-weight-bold" Size="Size.Small">
                                چاپ کارنامه
                            </MudButton>
                        </div>

                        <div id="divLessons">
                            <table class="schoolfars-table">
                                <thead>
                                    <tr class="rowHead">
                                        <th class="col0">ردیف</th>
                                        <th class="col1">نام درس</th>
                                        <th class="col2">تعداد</th>
                                        <th class="col3">صحیح</th>
                                        <th class="col4">غلط</th>
                                        <th class="col5">نزده</th>
                                        <th class="col6">درصد</th>
                                        <th class="col7">میانگین</th>
                                        <th class="col8">بیشترین</th>
                                        <th class="col9">تراز درس</th>
                                        <th class="col10">رتبه مدرسه</th>
                                        <th class="col11">رتبه کل</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rIdx = 1;
                                    }
                                    @foreach (var l in currentLessons)
                                    {
                                        string stripeClass = (rIdx % 2 == 0) ? "ev" : "odd";
                                        <tr class="@stripeClass">
                                            <td class="col0 text-center font-weight-bold">@(rIdx++)</td>
                                            <td class="col1 text-right font-weight-bold lesson-title-cell">
                                                @l.Name
                                                @if (!string.IsNullOrWhiteSpace(l.Status))
                                                {
                                                    <span class="lesson-tag">@l.Status</span>
                                                }
                                            </td>
                                            <td class="col2 text-center">@l.TotalQuestions</td>
                                            <td class="col3 text-center text-success font-weight-bold">@l.TrueCount</td>
                                            <td class="col4 text-center text-danger font-weight-bold">@l.FalseCount</td>
                                            <td class="col5 text-center text-muted">@l.BlankCount</td>
                                            <td class="col6 text-center font-weight-bold @(l.Percent >= 50 ? "text-success" : (l.Percent >= 25 ? "text-primary" : "text-danger"))">
                                                @l.Percent.ToString("F1")%
                                            </td>
                                            <td class="col7 text-center">@l.PercentAvg.ToString("F1")%</td>
                                            <td class="col8 text-center font-weight-bold text-primary">@l.PercentMax.ToString("F1")%</td>
                                            <td class="col9 text-center font-weight-bold @(l.Taraz >= 5000 ? "text-success" : "text-dark")">
                                                @l.Taraz.ToString("F1")
                                            </td>
                                            <td class="col10 text-center">@l.RankSchool</td>
                                            <td class="col11 text-center font-weight-bold">@l.RankTotal</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="rowFooter">
                                        <td class="col0 text-center font-weight-bold">Σ</td>
                                        <td class="col1 text-right font-weight-bold">مجموع کل و میانگین</td>
                                        <td class="col2 text-center font-weight-bold">@currentLessons.Sum(x => x.TotalQuestions)</td>
                                        <td class="col3 text-center font-weight-bold">@selectedReport.Total_True</td>
                                        <td class="col4 text-center font-weight-bold">@selectedReport.Total_False</td>
                                        <td class="col5 text-center font-weight-bold">@selectedReport.Total_Blank</td>
                                        <td class="col6 text-center font-weight-bold">@selectedReport.Total_Percent.ToString("F1")%</td>
                                        <td class="col7 text-center">@selectedReport.Total_PercentAvarage.ToString("F1")%</td>
                                        <td class="col8 text-center font-weight-bold">@selectedReport.Total_PercentMax.ToString("F1")%</td>
                                        <td class="col9 text-center font-weight-bold">@selectedReport.Total_Taraz.ToString("F1")</td>
                                        <td class="col10 text-center font-weight-bold">@selectedReport.Total_RankSchool</td>
                                        <td class="col11 text-center font-weight-bold">@selectedReport.Total_RankTotal</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                @if (activeTab == 1 || activeTab == 5)
                {
                    @* تب ۲: نمودارهای وضعیت دروس (StatusCharts) *@
                    <div class="report-section-card mt-4">
                        <div class="section-card-header">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="ml-2 text-primary" />
                            <h2 class="section-card-title">نمودار مقایسه درصد داوطلب با میانگین کشوری در دروس (StatusCharts)</h2>
                        </div>
                        <div class="chart-content-box">
                            @RenderLessonsBarChart()
                        </div>
                    </div>
                }

                @if (activeTab == 2 || activeTab == 5)
                {
                    @* تب ۳: روند پیشرفت تراز (ProgressChart) *@
                    <div class="report-section-card mt-4">
                        <div class="section-card-header">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Class="ml-2 text-primary" />
                            <h2 class="section-card-title">نمودار روند تغییرات نمرات تراز در مراحل آزمون (ProgressChart)</h2>
                        </div>
                        <div class="chart-content-box">
                            @RenderTarazLineChart()
                        </div>
                    </div>
                }

                @if (activeTab == 3 || activeTab == 5)
                {
                    @* تب ۴: پاسخ‌برگ چهارگزینه‌ای (AnswerSheet) *@
                    <div class="report-section-card mt-4">
                        <div class="section-card-header d-flex justify-space-between align-center flex-wrap gap-2">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Ballot" Class="ml-2 text-primary" />
                                <h2 class="section-card-title">پاسخ‌برگ تحلیلی چهارگزینه‌ای آزمون (AnswerSheet)</h2>
                            </div>
                            <div class="d-flex align-center gap-3 no-print">
                                <span class="legend-chip bg-ans-ok">✓ پاسخ صحیح داوطلب</span>
                                <span class="legend-chip bg-ans-err">✗ پاسخ اشتباه داوطلب</span>
                                <span class="legend-chip bg-ans-key">● کلید صحیح</span>
                                <span class="legend-chip bg-ans-blank">○ بدون پاسخ (سفید)</span>
                            </div>
                        </div>

                        <!-- نوار وضعیت، آمار و تنظیم سقف سوالات پاسخ‌برگ -->
                        <div class="d-flex justify-space-between align-center flex-wrap gap-3 py-2 px-3 my-2 rounded-lg bg-light-subtle border no-print" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <span class="fw-bold text-secondary" style="font-size: 0.85rem;">خلاصه پاسخ‌برگ:</span>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    تعداد سوالات: @currentAnswers.Count (حداکثر پیش‌فرض: ۳۰۰)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                    صحیح: @currentAnswers.Count(x => x.IsCorrect)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                    اشتباه: @currentAnswers.Count(x => x.IsWrong)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                    سفید: @currentAnswers.Count(x => x.IsBlank)
                                </MudChip>
                            </div>

                            <div class="d-flex align-center gap-1">
                                <span class="text-secondary ml-1" style="font-size: 0.8rem;">سقف نمایش:</span>
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    <MudButton Variant="@(maxAnswerSheetQuestions == 100 ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMaxQuestions(100))">۱۰۰</MudButton>
                                    <MudButton Variant="@(maxAnswerSheetQuestions == 200 ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMaxQuestions(200))">۲۰۰</MudButton>
