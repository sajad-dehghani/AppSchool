        public string Name { get; set; } = string.Empty;
        public float Percent { get; set; }
        public float PercentAvg { get; set; }
        public float PercentMax { get; set; }
        public float PercentMin { get; set; }
        public float TrueCount { get; set; }
        public float FalseCount { get; set; }
        public float BlankCount { get; set; }
        public float TotalQuestions => TrueCount + FalseCount + BlankCount;
        public float Taraz { get; set; }
        public float MaxTaraz { get; set; }
        public float RankSchool { get; set; }
        public float RankArea { get; set; }
        public float RankTotal { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    public class QuestionAnswerItem
    {
        public int QuestionNumber { get; set; }
        public int CorrectKey { get; set; }
        public int StudentChoice { get; set; }
        public bool IsCorrect => StudentChoice == CorrectKey && StudentChoice > 0;
        public bool IsBlank => StudentChoice <= 0;
        public bool IsWrong => StudentChoice > 0 && StudentChoice != CorrectKey;
    }
}

