    private RenderFragment RenderTarazLineChart() => __builder =>
    {
        if (!reportsList.Any()) return;

        double minT = Math.Max(0, reportsList.Min(r => r.Total_Taraz) - 500);
        double maxT = reportsList.Max(r => r.Total_Taraz) + 500;
        if (maxT <= minT) maxT = minT + 2000;

        int count = reportsList.Count;
        double svgWidth = 850;
        double svgHeight = 240;
        double padLeft = 80, padRight = 50, padTop = 30, padBottom = 50;

        double plotWidth = svgWidth - padLeft - padRight;
        double plotHeight = svgHeight - padTop - padBottom;

        var points = new List<(double X, double Y, Report_students Rep)>();
        for (int i = 0; i < count; i++)
        {
            var rep = reportsList[i];
            double x = count > 1 ? (svgWidth - padRight) - (i * (plotWidth / (count - 1))) : padLeft + plotWidth / 2;
            double norm = (rep.Total_Taraz - minT) / (maxT - minT);
            double y = padTop + plotHeight - (norm * plotHeight);
            points.Add((x, y, rep));
        }

        string polylinePoints = string.Join(" ", points.OrderBy(p => p.X).Select(p => $"{p.X:F1},{p.Y:F1}"));

        <div class="taraz-chart-wrapper">
            <svg viewBox="0 0 @svgWidth @svgHeight" class="taraz-svg-chart">
                <defs>
                    <linearGradient id="tarazLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#1565c0" />
                        <stop offset="50%" stop-color="#0288d1" />
                        <stop offset="100%" stop-color="#2e7d32" />
                    </linearGradient>
                </defs>

                <!-- خطوط افقی شبکه -->
                @for (int g = 0; g <= 4; g++)
                {
                    double gridNorm = g / 4.0;
                    double gridY = padTop + plotHeight - (gridNorm * plotHeight);
                    double gridVal = minT + (gridNorm * (maxT - minT));
                    <line x1="@padLeft" y1="@gridY" x2="@(svgWidth - padRight)" y2="@gridY" stroke="#e2e8f0" stroke-dasharray="4" />
                    @((MarkupString)$"<text x='{padLeft - 10}' y='{gridY + 4}' text-anchor='end' font-size='11' fill='#64748b'>{gridVal:F0}</text>")
                }

                @if (points.Count > 1)
                {
                    <polyline points="@polylinePoints" fill="none" stroke="url(#tarazLineGrad)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                }

                @foreach (var pt in points)
                {
                    bool isCur = selectedReport?.ID == pt.Rep.ID;
                    <circle cx="@pt.X" cy="@pt.Y" r="@(isCur ? 9 : 7)" fill="@(isCur ? "#ff6929" : "#ffffff")" stroke="#1565c0" stroke-width="3" style="cursor: pointer;" @onclick="() => SelectReport(pt.Rep)" />
                    <circle cx="@pt.X" cy="@pt.Y" r="3" fill="@(isCur ? "#ffffff" : "#1565c0")" />

                    @((MarkupString)$"<text x='{pt.X}' y='{pt.Y - 12}' text-anchor='middle' font-size='12' font-weight='bold' fill='#0d47a1'>{pt.Rep.Total_Taraz:F0}</text>")

                    string label = string.IsNullOrWhiteSpace(pt.Rep.ExamName) ? "مرحله " + pt.Rep.ID : pt.Rep.ExamName;
                    @((MarkupString)$"<text x='{pt.X}' y='{svgHeight - 15}' text-anchor='middle' font-size='11' fill='#334155'>{label}</text>")
                }
            </svg>
        </div>
    };

