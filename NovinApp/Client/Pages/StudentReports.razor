@code {
    [SupplyParameterFromQuery] public string? codeMeli { get; set; }

    private bool isLoading = true;
    private string searchNationalCode = string.Empty;
    private string targetNationalCode = string.Empty;
    private List<Report_students> reportsList = new();
    private Report_students? selectedReport;
    private Report_students? firstReport => reportsList.FirstOrDefault();

    private int activeTab = 0; // 0=Result, 1=StatusCharts, 2=ProgressChart, 3=AnswerSheet, 4=StWe, 5=FullPrint

    private List<LessonReportItem> currentLessons = new();
    private List<QuestionAnswerItem> currentAnswers = new();
    private int maxAnswerSheetQuestions = 300;

    private double MaxTaraz => reportsList.Any() ? reportsList.Max(r => r.Total_Taraz) : 0;
    private double AvgTaraz => reportsList.Any() ? reportsList.Average(r => r.Total_Taraz) : 0;

    protected override async Task OnInitializedAsync()
    {
        if (!UserProfileState.IsLoaded)
            await UserProfileState.LoadUserAsync();

        targetNationalCode = !string.IsNullOrWhiteSpace(codeMeli)
            ? codeMeli.Trim()
            : (UserProfileState.CurrentUser?.code_meli?.Trim() ?? string.Empty);

        searchNationalCode = targetNationalCode;

        if (!string.IsNullOrEmpty(targetNationalCode))
        {
            await LoadReportsAsync(targetNationalCode);
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchReports(searchNationalCode);
        }
    }

    private async Task SearchReports(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;
        targetNationalCode = code.Trim();
        await LoadReportsAsync(targetNationalCode);
    }

    private async Task LoadReportsAsync(string nationalCode)
    {
        isLoading = true;
        selectedReport = null;
        try
        {
            var result = await _httpClient.GetFromJsonAsync<List<Report_students>>($"api/Report_students/all/{nationalCode}");
            if (result != null && result.Any())
            {
                reportsList = result.OrderBy(r => r.ID).ToList();
                SelectReport(reportsList.Last()); // پیش‌فرض آخرین آزمون انتخاب می‌شود
            }
            else
            {
                reportsList = new();
                snackBar.Add($"هیچ کارنامه‌ای برای کد ملی {nationalCode} یافت نشد.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports: {ex.Message}");
            snackBar.Add("خطا در بارگذاری کارنامه‌ها از دیتابیس.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectReport(Report_students rep)
    {
        selectedReport = rep;
        currentLessons = ExtractLessons(rep);
        currentAnswers = ParseAnswerSheet(rep.KeySheet, rep.AnswerSheet, maxAnswerSheetQuestions);
    }

    private void SetMaxQuestions(int count)
    {
        maxAnswerSheetQuestions = count;
        if (selectedReport != null)
        {
            currentAnswers = ParseAnswerSheet(selectedReport.KeySheet, selectedReport.AnswerSheet, maxAnswerSheetQuestions);
            StateHasChanged();
        }
    }

    private string GetStudentName()
    {
        if (!string.IsNullOrWhiteSpace(selectedReport?.Student_FullName))
            return selectedReport.Student_FullName;
        if (!string.IsNullOrWhiteSpace(firstReport?.Student_FullName))
            return firstReport.Student_FullName;
        if (!string.IsNullOrWhiteSpace(UserProfileState.CurrentUser?.fname))
            return UserProfileState.CurrentUser.fname;
        return "دانش‌آموز گرامی";
    }

    private string FormatDate(DateTime dt)
    {
        if (dt == default || dt.Year < 2000)
            return "مرحله اخیر";
        return dt.ToString("yyyy/MM/dd");
    }

    private double CalcStatusMarkerRight()
    {
        if (selectedReport == null) return 50;
        // تراز معمول بین ۲۰۰۰ تا ۸۰۰۰
        double t = selectedReport.Total_Taraz;
        if (t <= 0) t = selectedReport.Total_Percent * 80;
        double norm = (t - 2500.0) / (7500.0 - 2500.0) * 100.0;
        return Math.Clamp(100.0 - norm, 4.0, 96.0); // معکوس جهت RTL
    }

    private string GetTotalStatusTitle()
    {
        if (selectedReport == null) return "متوسط";
        double t = selectedReport.Total_Taraz;
        if (t >= 6500) return "عالی";
        if (t >= 5800) return "خیلی خوب";
        if (t >= 5000) return "خوب";
        if (t >= 4200) return "متوسط";
        if (t >= 3500) return "ضعیف";
        return "بسیار ضعیف";
    }

    private string GetTotalStatusClass()
    {
        if (selectedReport == null) return "text-primary";
        double t = selectedReport.Total_Taraz;
        if (t >= 5800) return "text-success font-weight-bold";
        if (t >= 4500) return "text-primary font-weight-bold";
        return "text-danger font-weight-bold";
    }

    private async Task PrintReport()
    {
        activeTab = 5; // نمای کامل چاپی فعال شود
        StateHasChanged();
        await Task.Delay(150);
        await JS.InvokeVoidAsync("window.print");
    }

