@page "/Home"
@using Microsoft.AspNetCore.Authorization
@using NovinApp.Client.Service
@inject UserProfileStateService UserProfileState
@attribute [Authorize]

@* بنر خوش‌آمدگویی *@
<MudPaper Elevation="3" Class="pa-6 mb-5" Style="border-radius: 16px; background: linear-gradient(135deg, #0d47a1 0%, #1976d2 100%); color: white;">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold">
                سلام @(UserProfileState.CurrentUser?.fname ?? "دانش‌آموز گرامی")، به سامانه نوین خوش آمدید 👋
            </MudText>
            <MudText Typo="Typo.body1" Class="mt-2" Style="opacity: 0.95;">
                بستر هوشمند هدایت تحصیلی، آزمون‌های روانشناسی انتخاب رشته و پایش برنامه‌ریزی کنکور سراسری
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large" Icon="@Icons.Material.Filled.WorkspacePremium" Class="font-weight-bold text-dark">
                نقش: @(UserProfileState.CurrentUser?.Rool ?? "کاربر سامانه")
            </MudChip>
        </div>
    </div>
</MudPaper>

@* میانبرهای اصلی سامانه *@
<MudGrid Class="mb-5">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="action-card h-100" Style="border-radius: 14px; border-top: 5px solid #1976d2;">
            <MudCardContent Class="text-center pa-5">
                <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled" Class="mb-3 mx-auto">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Medium" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="font-weight-bold">تست انتخاب رشته</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    آزمون رغبت‌سنجی شغلی و تحصیلی هالند (RIASEC)
                </MudText>
            </MudCardContent>
            <MudCardActions Class="pa-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/Quiz" EndIcon="@Icons.Material.Filled.ArrowBack">
                    شروع آزمون
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="action-card h-100" Style="border-radius: 14px; border-top: 5px solid #2e7d32;">
            <MudCardContent Class="text-center pa-5">
                <MudAvatar Color="Color.Success" Size="Size.Large" Variant="Variant.Filled" Class="mb-3 mx-auto">
                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Medium" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="font-weight-bold">برنامه‌ریزی کنکور</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    ثبت ساعات مطالعه، تست‌ها و پایش هفتگی
                </MudText>
            </MudCardContent>
            <MudCardActions Class="pa-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Href="/StudyPlan" EndIcon="@Icons.Material.Filled.ArrowBack">
                    ثبت گزارش روزانه
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="action-card h-100" Style="border-radius: 14px; border-top: 5px solid #e65100;">
            <MudCardContent Class="text-center pa-5">
                <MudAvatar Color="Color.Warning" Size="Size.Large" Variant="Variant.Filled" Class="mb-3 mx-auto">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Medium" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="font-weight-bold">کارنامه آزمون‌ها</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    مشاهده تراز و درصدهای آزمون‌های آزمایشی
                </MudText>
            </MudCardContent>
            <MudCardActions Class="pa-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Href="/maping" EndIcon="@Icons.Material.Filled.ArrowBack">
                    تحلیل کارنامه
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="3" Class="action-card h-100" Style="border-radius: 14px; border-top: 5px solid #7b1fa2;">
            <MudCardContent Class="text-center pa-5">
                <MudAvatar Color="Color.Secondary" Size="Size.Large" Variant="Variant.Filled" Class="mb-3 mx-auto">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="font-weight-bold">پنل مشاوران</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    مشاهده لیست دانش‌آموزان و ارائه بازخورد
                </MudText>
            </MudCardContent>
            <MudCardActions Class="pa-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Href="/Students" EndIcon="@Icons.Material.Filled.ArrowBack">
                    مدیریت دانش‌آموزان
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@* وضعیت پیشرفت تحصیلی و آمادگی کنکور *@
<MudGrid Class="mt-2">
    <MudItem md="6" xs="12">
        <MudCard Elevation="3" Style="border-radius: 14px;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Speed" /></MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">پیشرفت هفتگی ساعات مطالعه</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">تطابق با بودجه‌بندی آزمون</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="font-weight-bold">ساعات اجرا شده: ۳۸ ساعت</span>
                    <span class="font-weight-bold text-success">۸۵% از هدف</span>
                </div>
                <MudProgressLinear Color="Color.Success" Size="Size.Large" Value="85" Rounded="true" Class="my-3" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    هدف مشاور برای هفته جاری: ۴۵ ساعت مطالعه مفید و ۷۵۰ تست اختصاصی
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem md="6" xs="12">
        <MudCard Elevation="3" Style="border-radius: 14px;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Info"><MudIcon Icon="@Icons.Material.Filled.AutoGraph" /></MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">آمادگی جامع کنکور سراسری</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">تسلط بر مباحث دهم، یازدهم و دوازدهم</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="font-weight-bold">پوشش سرفصل‌ها</span>
                    <span class="font-weight-bold text-primary">۶۸%</span>
                </div>
                <MudProgressLinear Color="Color.Primary" Size="Size.Large" Value="68" Rounded="true" Class="my-3" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    روند مطالعاتی شما بالاتر از میانگین منطقه آموزشی ارزیابی شده است.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    .action-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .action-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.12) !important;
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!UserProfileState.IsLoaded)
        {
            await UserProfileState.LoadUserAsync();
        }
    }
}
