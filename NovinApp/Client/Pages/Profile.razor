@page "/Profile"
@inject IJSRuntime JsRuntime
@inject ISnackbar snackBar
@inject NavigationManager nav
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using NovinApp.Client.Component
@using NovinApp.Client.Service
@using NovinApp.Shared
@using NovinApp.Shared.Constants
@inject IDialogService Dialog
@inject HttpClient _httpClient
@inject UserProfileStateService UserProfileState
@attribute [Authorize]

<div class="page-banner banner-primary mb-4">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="ml-2 align-middle" />
                پروفایل و اطلاعات حساب کاربری
            </MudText>
            <MudText Typo="Typo.body2" Class="text-white mt-1" Style="opacity: 0.9;">
                مشاهده و ویرایش مشخصات فردی، تصویر نمایه و رمز عبور
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Surface" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Class="text-primary font-weight-bold" OnClick="GoToBack">
            بازگشت
        </MudButton>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="ms-3">در حال دریافت اطلاعات کاربر...</MudText>
    </div>
}
else
{
    <EditForm Model="@data" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <MudGrid Spacing="3">
            @* کارت سمت راست: تصویر پروفایل و مشخصات کلیدی *@
            <MudItem xs="12" md="4">
                <MudPaper Elevation="3" Class="pa-6 rounded-2xl d-flex flex-column align-center text-center">
                    <div class="profile-avatar-container mb-4 position-relative">
                        @if (!string.IsNullOrEmpty(data.pic))
                        {
                            <MudAvatar Style="width: 140px; height: 140px;" Elevation="4">
                                <MudImage Src="@data.pic" Style="width: 100%; height: 100%; object-fit: cover;" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="Color.Primary" Style="width: 140px; height: 140px; font-size: 3rem;" Elevation="4">
                                @(string.IsNullOrEmpty(data.fname) ? "U" : data.fname.Substring(0, 1))
                            </MudAvatar>
                        }
                    </div>

                    <MudText Typo="Typo.h6" Class="font-weight-bold text-dark mb-1">
                        @(string.IsNullOrEmpty(data.fname) ? "کاربر گرامی" : data.fname)
                    </MudText>
                    
                    <MudChip T="string" Color="@GetRoleColor(data.Rool)" Variant="Variant.Filled" Size="Size.Small" Class="mb-4">
                        @UserRoles.GetPersianTitle(data.Rool)
                    </MudChip>

                    <div class="d-flex gap-2 flex-wrap justify-center mb-2">
                        <label for="profile-pic-input" class="label-wrapper">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera"
                                       Size="Size.Small" HtmlTag="span">
                                تغییر عکس
                            </MudButton>
                            <InputFile id="profile-pic-input" accept="image/*" OnChange="OnChange_pic" class="d-none" />
                        </label>

                        @if (!string.IsNullOrEmpty(data.pic))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small" OnClick="Del_pic">
                                حذف عکس
                            </MudButton>
                        }
                    </div>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        فرمت‌های مجاز: JPG, PNG | حداکثر حجم: ۲ مگابایت
                    </MudText>

                    <MudDivider Class="my-4 w-100" />

                    <div class="w-100 text-start">
                        <div class="d-flex justify-space-between mb-2">
                            <span class="text-muted small">کد ملی:</span>
                            <span class="font-weight-bold">@data.code_meli</span>
                        </div>
                        <div class="d-flex justify-space-between mb-2">
                            <span class="text-muted small">وضعیت حساب:</span>
                            <span class="@(data.active ? "text-success font-weight-bold" : "text-danger font-weight-bold")">
                                @(data.active ? "فعال" : "غیرفعال")
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(data.Moshaver) && data.Moshaver != "بدون مشاور")
                        {
                            <div class="d-flex justify-space-between mb-2">
                                <span class="text-muted small">مشاور تحصیلی:</span>
                                <span class="text-info font-weight-bold">@data.Moshaver</span>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            @* فرم ویرایش اطلاعات سمت چپ *@
            <MudItem xs="12" md="8">
                <MudPaper Elevation="3" Class="pa-6 rounded-2xl">
                    @* بخش ۱: اطلاعات فردی *@
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">اطلاعات فردی و هویتی</MudText>
                    </div>

                    <MudGrid Spacing="2" Class="mb-4">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="data.fname" Label="نام و نام خانوادگی" Variant="Variant.Outlined"
                                          Required="true" Margin="Margin.Dense" For="@(() => data.fname)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="data.code_meli" Label="کد ملی" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Required="true"
                                          ReadOnly="@(!UserProfileState.IsSystemAdmin)"
                                          Disabled="@(!UserProfileState.IsSystemAdmin)"
                                          HelperText="@(UserProfileState.IsSystemAdmin ? "دسترسی مدیر سیستم: ویرایش مجاز است" : "🔒 کد ملی تنها توسط مدیر سیستم قابل ویرایش است")"
                                          HelperTextOnFocus="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(UserProfileState.IsSystemAdmin ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="data.mobile" Label="شماره تلفن همراه" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" For="@(() => data.mobile)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="data.gender" Label="جنسیت" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("مرد")">مرد</MudSelectItem>
                                <MudSelectItem Value="@("زن")">زن</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    @* بخش ۲: امنیت و رمز عبور *@
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">امنیت و تغییر رمز عبور</MudText>
                    </div>

                    <MudGrid Spacing="2" Class="mb-4">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="newPassword" Label="رمز عبور جدید (در صورت تمایل به تغییر)"
                                          Variant="Variant.Outlined" InputType="InputType.Password" Margin="Margin.Dense"
                                          HelperText="در صورت خالی بودن، رمز عبور فعلی حفظ می‌شود" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="data.Rool" Label="نقش کاربری" Variant="Variant.Outlined"
                                       Margin="Margin.Dense" ReadOnly="@(!UserProfileState.IsSystemAdmin)">
                                <MudSelectItem Value="@(UserRoles.Student)">دانش‌آموز</MudSelectItem>
                                <MudSelectItem Value="@(UserRoles.Consultant)">مشاور تحصیلی</MudSelectItem>
                                <MudSelectItem Value="@(UserRoles.SchoolManager)">مدیر مدرسه</MudSelectItem>
                                <MudSelectItem Value="@(UserRoles.SystemAdmin)">مدیر سیستم</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <div class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="GoToBack" Size="Size.Large">
                            انصراف
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                                   StartIcon="@Icons.Material.Filled.Save" Size="Size.Large" Disabled="isSaving">
                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                <span>در حال ذخیره...</span>
                            }
                            else
                            {
                                <span>ذخیره تغییرات</span>
                            }
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {
    private User data = new();
    private string newPassword = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        isLoading = true;
        try
        {
            if (!UserProfileState.IsLoaded)
                await UserProfileState.LoadUserAsync();

            var currentId = UserProfileState.CurrentUser?.Id;
            if (currentId.HasValue && currentId.Value > 0)
            {
                var user = await _httpClient.GetFromJsonAsync<User>($"api/User/{currentId.Value}");
                if (user != null)
                {
                    data = user;
                }
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا در دریافت اطلاعات کاربر: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnChange_pic(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 2 * 1024 * 1024)
        {
            snackBar.Add("حجم فایل تصویر نباید بیشتر از ۲ مگابایت باشد.", Severity.Warning);
            return;
        }

        try
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(2 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var uploadRes = await _httpClient.PostAsync("api/Upload", content);
            if (uploadRes.IsSuccessStatusCode)
            {
                var json = await uploadRes.Content.ReadFromJsonAsync<UploadResponse>();
                if (!string.IsNullOrEmpty(json?.url))
                {
                    data.pic = json.url;
                    snackBar.Add("تصویر با موفقیت بارگذاری شد.", Severity.Success);
                }
            }
            else
            {
                // روش جایگزین: Base64 در صورت عدم دسترسی به Upload API
                var buf = new byte[file.Size];
                using (var stream = file.OpenReadStream(2 * 1024 * 1024))
                {
                    await stream.ReadAsync(buf);
                }
                data.pic = $"data:{file.ContentType};base64,{Convert.ToBase64String(buf)}";
                snackBar.Add("تصویر انتخاب شد.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا در بارگذاری تصویر: {ex.Message}", Severity.Error);
        }
    }

    private void Del_pic()
    {
        data.pic = null;
        snackBar.Add("تصویر پروفایل حذف گردید.", Severity.Info);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(data.fname))
        {
            snackBar.Add("نام و نام خانوادگی الزامی است.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(newPassword))
            {
                data.pass = newPassword.Trim();
            }

            var res = await _httpClient.PutAsJsonAsync("api/User", data);
            if (res.IsSuccessStatusCode)
            {
                snackBar.Add("اطلاعات حساب کاربری با موفقیت به‌روزرسانی شد.", Severity.Success);
                await UserProfileState.LoadUserAsync();
                newPassword = string.Empty;
            }
            else
            {
                snackBar.Add("خطا در ذخیره اطلاعات حساب کاربری.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            snackBar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoToBack()
    {
        nav.NavigateTo("/");
    }

    private Color GetRoleColor(string? role)
    {
        return role switch
        {
            UserRoles.SystemAdmin => Color.Error,
            UserRoles.SchoolManager => Color.Warning,
            UserRoles.Consultant => Color.Success,
            UserRoles.Student => Color.Info,
            _ => Color.Default
        };
    }

    private class UploadResponse
    {
        public string? url { get; set; }
        public string? fullUrl { get; set; }
    }
}